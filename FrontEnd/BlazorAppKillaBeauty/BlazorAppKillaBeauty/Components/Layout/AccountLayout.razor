@inherits LayoutComponentBase
@layout MainLayout
@inject AuthService AuthService
@using BlazorAppKillaBeauty.Services
@inject CartService CartService

<Navbar CantidadCarrito="@CartService.CantidadTotal" />

<div class="page-background-wrapper">
    <div class="account-main-container">
        <h1 class="main-page-title">Mi Cuenta</h1>
        
        <div class="account-layout-grid">
            <div class="account-sidebar-card">
                <div class="profile-avatar-zone">
                    <div class="avatar-circle">C</div>
                    <h2 class="avatar-name">@AuthService.NombreUsuario</h2>
                    <span class="avatar-email">cliente@ejemplo.com</span>
                </div>
                
                <SidebarMenu />
            </div>

            <div class="account-content-card">
                @Body
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] NavigationManager Navigation { get; set; }
    protected override void OnInitialized()
    {
        if (!AuthService.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
        }
    }
}