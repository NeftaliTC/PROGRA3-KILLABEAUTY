@page "/admin/reportes"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Reportes Admin - Killa Beauty</PageTitle>

<main class="admin-page">
    <AdminNavbar />

    <section class="admin-content admin-reports-content">

        <div class="admin-breadcrumb">
            <span>Inicio</span>
            <i class="bi bi-chevron-right"></i>
            <span>Pedidos</span>
            <i class="bi bi-chevron-right"></i>
            <span>Reportes</span>
        </div>

        <header class="admin-reports-header">
            <div>
                <h1>@TituloReporte</h1>
            </div>

            <div class="admin-reports-header-actions">
                <div class="admin-reports-dropdown">
                    <button type="button" class="btn-report-dropdown" @onclick="ToggleMenuReportes">
                        @TextoDropdown
                        <i class="bi bi-chevron-down"></i>
                    </button>

                    @if (mostrarMenuReportes)
                    {
                        <div class="admin-reports-dropdown-menu">
                            <button type="button" @onclick="() => SeleccionarReporte(ReporteTipo.Ventas)">
                                Reporte de ventas
                            </button>
                            <button type="button" @onclick="() => SeleccionarReporte(ReporteTipo.Inventario)">
                                Reporte de inventario
                            </button>
                        </div>
                    }
                </div>

                <button type="button" class="admin-primary-action" @onclick="DescargarReporte">
                    <i class="bi bi-download"></i>
                    Descargar reporte
                </button>
            </div>
        </header>

        <section class="admin-reports-filters">
            <div class="filters-left">
                <div class="filter-inline">
                    <i class="bi bi-calendar3"></i>

                    <select class="filter-select" @bind="mesSeleccionado">
                        @foreach (var mes in meses)
                        {
                            <option value="@mes.Valor">@mes.Texto</option>
                        }
                    </select>

                    <select class="filter-select" @bind="anioSeleccionado">
                        @foreach (var anio in anios)
                        {
                            <option value="@anio">@anio</option>
                        }
                    </select>
                </div>
            </div>

            <div class="filters-right">
                @if (reporteActual == ReporteTipo.Ventas)
                {
                    <div class="filters-sale-type">
                        <span class="filter-label">Tipo de venta:</span>

                        <label class="check-pill">
                            <input type="checkbox" @bind="ventasMayorista" />
                            <span>Mayorista</span>
                        </label>

                        <label class="check-pill">
                            <input type="checkbox" @bind="ventasMinorista" />
                            <span>Minorista</span>
                        </label>

                        <label class="check-pill">
                            <input type="checkbox" @bind="ventasTodas" />
                            <span>Todas las ventas</span>
                        </label>
                    </div>
                }
                else
                {
                    <div class="filters-sale-type">
                        <span class="filter-label">Tipo de venta:</span>

                        <label class="switch-pill">
                            <span>Mayorista</span>
                            <label class="switch">
                                <input type="checkbox" @bind="inventarioMayorista" />
                                <span class="slider"></span>
                            </label>
                        </label>

                        <label class="switch-pill">
                            <span>Minorista</span>
                            <label class="switch">
                                <input type="checkbox" @bind="inventarioMinorista" />
                                <span class="slider"></span>
                            </label>
                        </label>
                    </div>
                }
            </div>
        </section>

        @if (reporteActual == ReporteTipo.Ventas)
        {
            <section class="admin-reports-kpis">
                <article class="report-kpi-card">
                    <div>
                        <span>Ingresos totales</span>
                        <strong>S/. @ventasKpis.Ingresos.ToString("N2")</strong>
                        <small class="kpi-pill-success">
                            +@ventasKpis.CrecimientoVsMesAnterior% más vs mes anterior
                        </small>
                    </div>
                    <i class="bi bi-cash-stack"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Pedidos totales</span>
                        <strong>@ventasKpis.PedidosTotales.ToString("N0")</strong>
                    </div>
                    <i class="bi bi-truck"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Tiket promedio</span>
                        <strong>S/. @ventasKpis.TicketPromedio.ToString("N2")</strong>
                    </div>
                    <i class="bi bi-basket2"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Descuento promedio</span>
                        <strong>@ventasKpis.DescuentoPromedio.ToString("0.0")%</strong>
                    </div>
                    <i class="bi bi-gift"></i>
                </article>
            </section>

            <section class="admin-reports-charts">
                <article class="chart-card chart-wide">
                    <header class="chart-title">
                        Ventas en el tiempo (@MesTexto @anioSeleccionado)
                    </header>
                    @* <div class="chart-placeholder">
                        <i class="bi bi-graph-up"></i>
                        <span>Gráfico de líneas (placeholder)</span>
                    </div> *@
                    <div class="chart-canvas-box">
                        <canvas id="ventasLineChart"></canvas>
                    </div>
                </article>

                <article class="chart-card">
                    <header class="chart-title">Comparación semanal</header>
                    @* <div class="chart-placeholder">
                        <i class="bi bi-bar-chart"></i>
                        <span>Gráfico de barras (placeholder)</span>
                    </div> *@
                    <div class="chart-canvas-box">
                        <canvas id="ventasBarChart"></canvas>
                    </div>
                </article>
            </section>

            <section class="admin-reports-list">
                <header class="list-title">
                    Productos más vendidos (@MesTexto @anioSeleccionado)
                </header>

                <div class="list-card">
                    @for (int i = 0; i < productosMasVendidos.Count; i++)
                    {
                        var p = productosMasVendidos[i];

                        <div class="top-product-row">
                            <div class="top-rank">#@(i + 1)</div>

                            <div class="top-product-img">
                                <img src="@p.ImagenUrl" alt="@p.Nombre" />
                            </div>

                            <div class="top-product-main">
                                <strong>@p.Nombre</strong>
                                <span>@p.CantidadVendida unidades · @p.Categoria</span>
                            </div>

                            <div class="top-product-meta">
                                <span>@p.Marca</span>
                                <span>Precio unitario: S/. @p.PrecioUnitario.ToString("N2")</span>
                            </div>
                        </div>

                        @if (i < productosMasVendidos.Count - 1)
                        {
                            <div class="row-divider"></div>
                        }
                    }
                </div>
            </section>
        }
        else
        {
            <section class="admin-reports-kpis">
                <article class="report-kpi-card">
                    <div>
                        <span>Valor total de inventario</span>
                        <strong>S/. @inventarioKpis.ValorTotal.ToString("N2")</strong>
                    </div>
                    <i class="bi bi-box-seam"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Productos con stock crítico</span>
                        <strong>@inventarioKpis.StockCritico</strong>
                        <button type="button"
                                class="kpi-review-button kpi-pill-warning"
                                @onclick="() => SeleccionarStockTab(StockTab.Critico)">
                            revisar más
                        </button>
                    </div>
                    <i class="bi bi-exclamation-triangle"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Productos agotados</span>
                        <strong>@inventarioKpis.Agotados</strong>
                        <button type="button"
                                class="kpi-review-button kpi-pill-danger"
                                @onclick="() => SeleccionarStockTab(StockTab.Agotado)">
                            revisar más
                        </button>
                    </div>
                    <i class="bi bi-x-circle"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Productos con stock saludable</span>
                        <strong>@inventarioKpis.Saludable</strong>
                        <button type="button"
                                class="kpi-review-button kpi-pill-success"
                                @onclick="() => SeleccionarStockTab(StockTab.Saludable)">
                            revisar más
                        </button>
                    </div>
                    <i class="bi bi-check2-circle"></i>
                </article>
            </section>

            <section class="admin-reports-charts">
                <article class="chart-card chart-wide">
                    <header class="chart-title">Niveles de Stock por Categoría</header>
                    <div class="chart-placeholder">
                        <i class="bi bi-bar-chart-steps"></i>
                        <span>Gráfico apilado (placeholder)</span>
                    </div>
                </article>

                <article class="chart-card">
                    <header class="chart-title">Análisis de Rotación de Inventario</header>
                    @* <div class="chart-placeholder">
                        <i class="bi bi-pie-chart"></i>
                        <span>Gráfico donut (placeholder)</span>
                    </div> *@
                    <div class="chart-canvas-box">
                        <canvas id="inventarioDonutChart"></canvas>
                    </div>
                </article>
            </section>

        }

    </section>
</main>

@if (mostrarModalInventario)
{
    <div class="inventory-stock-modal-overlay" @onclick="CerrarStockModal">
        <section class="inventory-stock-modal-card" @onclick:stopPropagation="true">
            <header class="inventory-stock-modal-title">
                <div>
                    <h2>Detalle de inventario</h2>
                    <p>Revisa los productos según su estado de stock.</p>
                </div>

                <button type="button" @onclick="CerrarStockModal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <section class="inventory-stock-table-card">
                <header class="inventory-stock-header">
                    <div>
                        <h2>@TituloStockTab</h2>
                        <p>@DescripcionStockTab</p>
                    </div>
                    <span>@ProductosInventarioFiltrados.Count producto@(ProductosInventarioFiltrados.Count == 1 ? "" : "s")</span>
                </header>

                <table class="admin-table inventory-stock-table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Marca</th>
                            <th>Stock</th>
                            <th>Precio unitario</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in ProductosInventarioFiltrados)
                        {
                            <tr>
                                <td>
                                    <div class="inventory-product-cell">
                                        <img src="@producto.ImagenUrl" alt="@producto.Nombre" />
                                        <div>
                                            <strong>@producto.Nombre</strong>
                                            <span>@producto.Sku</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@producto.Categoria</td>
                                <td>@producto.Marca</td>
                                <td>@producto.StockActual u.</td>
                                <td>S/. @producto.PrecioUnitario.ToString("N2")</td>
                                <td>
                                    <span class="inventory-stock-badge @GetStockBadgeClass(producto.StockEstado)">
                                        @GetStockEstadoTexto(producto.StockEstado)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </section>
    </div>
}

@code {
    private enum ReporteTipo { Ventas, Inventario }
    private enum StockTab { Critico, Agotado, Saludable }

    private ReporteTipo reporteActual = ReporteTipo.Ventas;
    private StockTab stockTabActual = StockTab.Critico;
    private bool mostrarModalInventario = false;
    private bool mostrarMenuReportes = false;

    private int mesSeleccionado = 5;
    private int anioSeleccionado = 2025;

    private List<int> anios = new() { 2026, 2025, 2024 };

    private List<MesFiltro> meses = new()
    {
        new(1, "Enero"), new(2, "Febrero"), new(3, "Marzo"), new(4, "Abril"),
        new(5, "Mayo"), new(6, "Junio"), new(7, "Julio"), new(8, "Agosto"),
        new(9, "Septiembre"), new(10, "Octubre"), new(11, "Noviembre"), new(12, "Diciembre")
    };

    // filtros “tipo de venta”
    private bool ventasMayorista = true;
    private bool ventasMinorista = true;
    private bool ventasTodas = true;

    private bool inventarioMayorista = false;
    private bool inventarioMinorista = true;

    // mock data
    private VentasKpis ventasKpis = new(50560.00m, 1138, 122.50m, 5.4m, 5);
    private InventarioKpis inventarioKpis => new(
        productosInventario.Sum(p => p.StockActual * p.PrecioUnitario),
        productosInventario.Count(p => p.StockEstado == StockTab.Critico),
        productosInventario.Count(p => p.StockEstado == StockTab.Agotado),
        productosInventario.Count(p => p.StockEstado == StockTab.Saludable));

    private List<TopProducto> productosMasVendidos = new()
    {
        new TopProducto("Agua Micelar con Aceite Óleo Garnier Skin Active 100 ml", "Garnier", "Skincare", 320, 19.50m, "/Images/placeholder-product.png"),
        new TopProducto("Máscara Essence Prince False Lash Effect", "Essence", "Maquillaje", 285, 52.90m, "/Images/placeholder-product.png"),
        new TopProducto("Protector Solar SPF50", "La Roche-Posay", "Skincare", 210, 79.00m, "/Images/placeholder-product.png"),
    };

    private List<ProductoInventario> productosInventario = CrearProductosInventario();

    private string MesTexto => meses.First(m => m.Valor == mesSeleccionado).Texto;

    private string TituloReporte => reporteActual == ReporteTipo.Ventas
        ? "Reporte de ventas"
        : "Reporte de inventario";

    private string TextoDropdown => reporteActual == ReporteTipo.Ventas
        ? "Reporte de ventas"
        : "Reporte de inventario";

    private void ToggleMenuReportes() => mostrarMenuReportes = !mostrarMenuReportes;

    private void SeleccionarReporte(ReporteTipo tipo)
    {
        reporteActual = tipo;
        mostrarMenuReportes = false;

        _ = InvokeAsync(RenderChartsAsync);
    }

    private void SeleccionarStockTab(StockTab tab)
    {
        stockTabActual = tab;
        mostrarModalInventario = true;
    }

    private void CerrarStockModal() => mostrarModalInventario = false;

    private void DescargarReporte()
    {
        // interacción mock
        // luego pueden implementarlo con export real
    }

    private record MesFiltro(int Valor, string Texto);

    private record VentasKpis(decimal Ingresos, int PedidosTotales, decimal TicketPromedio, decimal DescuentoPromedio, int CrecimientoVsMesAnterior);

    private record InventarioKpis(decimal ValorTotal, int StockCritico, int Agotados, int Saludable);

    private record TopProducto(string Nombre, string Marca, string Categoria, int CantidadVendida, decimal PrecioUnitario, string ImagenUrl);

    private record ProductoInventario(
        string Sku,
        string Nombre,
        string Marca,
        string Categoria,
        int StockActual,
        decimal PrecioUnitario,
        StockTab StockEstado,
        string ImagenUrl);

    private List<ProductoInventario> ProductosInventarioFiltrados =>
        productosInventario
            .Where(p => p.StockEstado == stockTabActual)
            .OrderBy(p => p.StockActual)
            .ThenBy(p => p.Nombre)
            .ToList();

    private string TituloStockTab => stockTabActual switch
    {
        StockTab.Critico => "Productos con stock crítico",
        StockTab.Agotado => "Productos agotados",
        _ => "Productos con stock saludable"
    };

    private string DescripcionStockTab => stockTabActual switch
    {
        StockTab.Critico => "Productos que necesitan reposición pronto por estar debajo del umbral mínimo.",
        StockTab.Agotado => "Productos sin unidades disponibles para venta.",
        _ => "Productos con disponibilidad suficiente para atender pedidos."
    };

    private static string GetStockEstadoTexto(StockTab estado) => estado switch
    {
        StockTab.Critico => "Crítico",
        StockTab.Agotado => "Agotado",
        _ => "Saludable"
    };

    private static string GetStockBadgeClass(StockTab estado) => estado switch
    {
        StockTab.Critico => "stock-warning",
        StockTab.Agotado => "stock-danger",
        _ => "stock-success"
    };

    private static List<ProductoInventario> CrearProductosInventario()
    {
        var productos = new List<ProductoInventario>
        {
            new("KB-SK-001", "Sérum vitamina C 30ml", "The Ordinary", "Skincare", 4, 45.00m, StockTab.Critico, "/Images/Serum.jpg"),
            new("KB-SK-002", "Crema hidratante CeraVe", "CeraVe", "Skincare", 7, 69.90m, StockTab.Critico, "/Images/Cerave.jpg"),
            new("KB-MQ-003", "Máscara Essence Lash Effect", "Essence", "Maquillaje", 5, 52.90m, StockTab.Critico, "/Images/Mascara.jpg"),
            new("KB-CB-004", "Tratamiento Lorinique cabello", "Lorinique", "Cabello", 3, 88.00m, StockTab.Critico, "/Images/LoriniqueCabello.jpg"),
            new("KB-MQ-005", "Labial Peripera Ink", "Peripera", "Maquillaje", 6, 40.00m, StockTab.Critico, "/Images/LabialPeripera.jpg"),
            new("KB-SK-006", "Agua micelar Garnier 100ml", "Garnier", "Skincare", 8, 19.50m, StockTab.Critico, "/Images/CuidadoPiel.png"),
            new("KB-MQ-007", "Paleta básica de maquillaje", "Killa Beauty", "Maquillaje", 2, 79.90m, StockTab.Critico, "/Images/Maquillaje.png"),
            new("KB-FR-008", "Fragancia floral compacta", "Killa Beauty", "Fragancias", 1, 59.00m, StockTab.Critico, "/Images/Fragancia.png"),

            new("KB-SK-009", "Protector solar SPF50", "La Roche-Posay", "Skincare", 0, 79.00m, StockTab.Agotado, "/Images/CuidadoPiel.png"),
            new("KB-CB-010", "Shampoo reparador premium", "Lorinique", "Cabello", 0, 36.90m, StockTab.Agotado, "/Images/CuidadoCabello.png"),
            new("KB-MQ-011", "Delineador negro waterproof", "NYX", "Maquillaje", 0, 29.90m, StockTab.Agotado, "/Images/Maquillaje.png"),
            new("KB-SK-012", "Tónico hidratante facial", "CeraVe", "Skincare", 0, 49.90m, StockTab.Agotado, "/Images/Cerave.jpg"),
            new("KB-FR-013", "Body mist vainilla", "Killa Beauty", "Fragancias", 0, 34.90m, StockTab.Agotado, "/Images/Fragancia.png"),
        };

        productos.AddRange(Enumerable.Range(1, 118).Select(i =>
        {
            var categoria = i % 3 == 0 ? "Skincare" : i % 3 == 1 ? "Maquillaje" : "Cabello";
            var marca = i % 4 == 0 ? "CeraVe" : i % 4 == 1 ? "Killa Beauty" : i % 4 == 2 ? "Essence" : "Lorinique";
            var imagen = categoria == "Skincare" ? "/Images/CuidadoPiel.png" :
                         categoria == "Maquillaje" ? "/Images/Maquillaje.png" :
                         "/Images/CuidadoCabello.png";

            return new ProductoInventario(
                $"KB-ST-{i:000}",
                $"Producto saludable {i:000}",
                marca,
                categoria,
                20 + (i % 60),
                24.90m + (i % 9) * 5,
                StockTab.Saludable,
                imagen);
        }));

        return productos;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // La primera vez, dibuja
        if (firstRender)
        {
            await RenderChartsAsync();
        }
    }

    private async Task RenderChartsAsync()
    {
        if (reporteActual == ReporteTipo.Ventas)
        {
            var labels = Enumerable.Range(1, 12).Select(d => $"{d} May").ToArray();
            var values = new[] { 50, 70, 85, 60, 95, 110, 90, 105, 80, 120, 95, 100 };

            await JS.InvokeVoidAsync("killaCharts.createOrUpdateLineChart",
                "ventasLineChart", labels, values, "Unidades vendidas");

            var labelsBar = new[] { "Abril / Semana 4", "Mayo / Semana 1", "Mayo / Semana 2", "Mayo / Semana 3" };
            var valuesBar = new[] { 90, 120, 135, 110 };

            await JS.InvokeVoidAsync("killaCharts.createOrUpdateBarChart",
                "ventasBarChart", labelsBar, valuesBar, "Unidades");
        }
        else
        {
            var labels = new[] { "SKU mov fast", "SKU promedio", "SKU lento moving", "Sin movimiento" };
            var values = new[] { 55, 45, 19, 0 };

            await JS.InvokeVoidAsync("killaCharts.createOrUpdateDonutChart",
                "inventarioDonutChart", labels, values);
        }
    }
}
