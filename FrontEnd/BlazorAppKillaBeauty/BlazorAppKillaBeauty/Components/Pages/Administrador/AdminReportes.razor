@page "/admin/reportes"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Reportes Admin - Killa Beauty</PageTitle>

<main class="admin-page">
    <AdminNavbar />

    <section class="admin-content admin-reports-content">

        <div class="admin-breadcrumb">
            <span>Inicio</span>
            <i class="bi bi-chevron-right"></i>
            <span>Pedidos</span>
            <i class="bi bi-chevron-right"></i>
            <span>Reportes</span>
        </div>

        <header class="admin-reports-header">
            <div>
                <h1>@TituloReporte</h1>
            </div>

            <div class="admin-reports-header-actions">
                <div class="admin-reports-dropdown">
                    <button type="button" class="btn-report-dropdown" @onclick="ToggleMenuReportes">
                        @TextoDropdown
                        <i class="bi bi-chevron-down"></i>
                    </button>

                    @if (mostrarMenuReportes)
                    {
                        <div class="admin-reports-dropdown-menu">
                            <button type="button" @onclick="() => SeleccionarReporte(ReporteTipo.Ventas)">
                                Reporte de ventas
                            </button>
                            <button type="button" @onclick="() => SeleccionarReporte(ReporteTipo.Inventario)">
                                Reporte de inventario
                            </button>
                        </div>
                    }
                </div>

                <button type="button" class="admin-primary-action" @onclick="DescargarReporte">
                    <i class="bi bi-download"></i>
                    Descargar reporte
                </button>
            </div>
        </header>

        <section class="admin-reports-filters">
            <div class="filters-left">
                <div class="filter-inline">
                    <i class="bi bi-calendar3"></i>

                    <select class="filter-select" @bind="mesSeleccionado">
                        @foreach (var mes in meses)
                        {
                            <option value="@mes.Valor">@mes.Texto</option>
                        }
                    </select>

                    <select class="filter-select" @bind="anioSeleccionado">
                        @foreach (var anio in anios)
                        {
                            <option value="@anio">@anio</option>
                        }
                    </select>
                </div>
            </div>

            <div class="filters-right">
                @if (reporteActual == ReporteTipo.Ventas)
                {
                    <div class="filters-sale-type">
                        <span class="filter-label">Tipo de venta:</span>

                        <label class="check-pill">
                            <input type="checkbox" @bind="ventasMayorista" />
                            <span>Mayorista</span>
                        </label>

                        <label class="check-pill">
                            <input type="checkbox" @bind="ventasMinorista" />
                            <span>Minorista</span>
                        </label>

                        <label class="check-pill">
                            <input type="checkbox" @bind="ventasTodas" />
                            <span>Todas las ventas</span>
                        </label>
                    </div>
                }
                else
                {
                    <div class="filters-sale-type">
                        <span class="filter-label">Tipo de venta:</span>

                        <label class="switch-pill">
                            <span>Mayorista</span>
                            <label class="switch">
                                <input type="checkbox" @bind="inventarioMayorista" />
                                <span class="slider"></span>
                            </label>
                        </label>

                        <label class="switch-pill">
                            <span>Minorista</span>
                            <label class="switch">
                                <input type="checkbox" @bind="inventarioMinorista" />
                                <span class="slider"></span>
                            </label>
                        </label>
                    </div>
                }
            </div>
        </section>

        @if (reporteActual == ReporteTipo.Ventas)
        {
            <section class="admin-reports-kpis">
                <article class="report-kpi-card">
                    <div>
                        <span>Ingresos totales</span>
                        <strong>S/. @ventasKpis.Ingresos.ToString("N2")</strong>
                        <small class="kpi-pill-success">
                            +@ventasKpis.CrecimientoVsMesAnterior% más vs mes anterior
                        </small>
                    </div>
                    <i class="bi bi-cash-stack"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Pedidos totales</span>
                        <strong>@ventasKpis.PedidosTotales.ToString("N0")</strong>
                    </div>
                    <i class="bi bi-truck"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Tiket promedio</span>
                        <strong>S/. @ventasKpis.TicketPromedio.ToString("N2")</strong>
                    </div>
                    <i class="bi bi-basket2"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Descuento promedio</span>
                        <strong>@ventasKpis.DescuentoPromedio.ToString("0.0")%</strong>
                    </div>
                    <i class="bi bi-gift"></i>
                </article>
            </section>

            <section class="admin-reports-charts">
                <article class="chart-card chart-wide">
                    <header class="chart-title">
                        Ventas en el tiempo (@MesTexto @anioSeleccionado)
                    </header>
                    @* <div class="chart-placeholder">
                        <i class="bi bi-graph-up"></i>
                        <span>Gráfico de líneas (placeholder)</span>
                    </div> *@
                    <div class="chart-canvas-box">
                        <canvas id="ventasLineChart"></canvas>
                    </div>
                </article>

                <article class="chart-card">
                    <header class="chart-title">Comparación semanal</header>
                    @* <div class="chart-placeholder">
                        <i class="bi bi-bar-chart"></i>
                        <span>Gráfico de barras (placeholder)</span>
                    </div> *@
                    <div class="chart-canvas-box">
                        <canvas id="ventasBarChart"></canvas>
                    </div>
                </article>
            </section>

            <section class="admin-reports-list">
                <header class="list-title">
                    Productos más vendidos (@MesTexto @anioSeleccionado)
                </header>

                <div class="list-card">
                    @for (int i = 0; i < productosMasVendidos.Count; i++)
                    {
                        var p = productosMasVendidos[i];

                        <div class="top-product-row">
                            <div class="top-rank">#@(i + 1)</div>

                            <div class="top-product-img">
                                <img src="@p.ImagenUrl" alt="@p.Nombre" />
                            </div>

                            <div class="top-product-main">
                                <strong>@p.Nombre</strong>
                                <span>@p.CantidadVendida unidades · @p.Categoria</span>
                            </div>

                            <div class="top-product-meta">
                                <span>@p.Marca</span>
                                <span>Precio unitario: S/. @p.PrecioUnitario.ToString("N2")</span>
                            </div>
                        </div>

                        @if (i < productosMasVendidos.Count - 1)
                        {
                            <div class="row-divider"></div>
                        }
                    }
                </div>
            </section>
        }
        else
        {
            <section class="admin-reports-kpis">
                <article class="report-kpi-card">
                    <div>
                        <span>Valor total de inventario</span>
                        <strong>S/. @inventarioKpis.ValorTotal.ToString("N2")</strong>
                    </div>
                    <i class="bi bi-box-seam"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Productos con stock crítico</span>
                        <strong>@inventarioKpis.StockCritico</strong>
                        <small class="kpi-pill-warning">revisar</small>
                    </div>
                    <i class="bi bi-exclamation-triangle"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Productos agotados</span>
                        <strong>@inventarioKpis.Agotados</strong>
                        <small class="kpi-pill-danger">revisar</small>
                    </div>
                    <i class="bi bi-x-circle"></i>
                </article>

                <article class="report-kpi-card">
                    <div>
                        <span>Productos con stock saludable</span>
                        <strong>@inventarioKpis.Saludable</strong>
                        <small class="kpi-pill-success">revisar</small>
                    </div>
                    <i class="bi bi-check2-circle"></i>
                </article>
            </section>

            <section class="admin-reports-charts">
                <article class="chart-card chart-wide">
                    <header class="chart-title">Niveles de Stock por Categoría</header>
                    <div class="chart-placeholder">
                        <i class="bi bi-bar-chart-steps"></i>
                        <span>Gráfico apilado (placeholder)</span>
                    </div>
                </article>

                <article class="chart-card">
                    <header class="chart-title">Análisis de Rotación de Inventario</header>
                    @* <div class="chart-placeholder">
                        <i class="bi bi-pie-chart"></i>
                        <span>Gráfico donut (placeholder)</span>
                    </div> *@
                    <div class="chart-canvas-box">
                        <canvas id="inventarioDonutChart"></canvas>
                    </div>
                </article>
            </section>
        }

    </section>
</main>

@code {
    private enum ReporteTipo { Ventas, Inventario }

    private ReporteTipo reporteActual = ReporteTipo.Ventas;
    private bool mostrarMenuReportes = false;

    private int mesSeleccionado = 5;
    private int anioSeleccionado = 2025;

    private List<int> anios = new() { 2026, 2025, 2024 };

    private List<MesFiltro> meses = new()
    {
        new(1, "Enero"), new(2, "Febrero"), new(3, "Marzo"), new(4, "Abril"),
        new(5, "Mayo"), new(6, "Junio"), new(7, "Julio"), new(8, "Agosto"),
        new(9, "Septiembre"), new(10, "Octubre"), new(11, "Noviembre"), new(12, "Diciembre")
    };

    // filtros “tipo de venta”
    private bool ventasMayorista = true;
    private bool ventasMinorista = true;
    private bool ventasTodas = true;

    private bool inventarioMayorista = false;
    private bool inventarioMinorista = true;

    // mock data
    private VentasKpis ventasKpis = new(50560.00m, 1138, 122.50m, 5.4m, 5);
    private InventarioKpis inventarioKpis = new(150560.00m, 8, 5, 118);

    private List<TopProducto> productosMasVendidos = new()
    {
        new TopProducto("Agua Micelar con Aceite Óleo Garnier Skin Active 100 ml", "Garnier", "Skincare", 320, 19.50m, "/Images/placeholder-product.png"),
        new TopProducto("Máscara Essence Prince False Lash Effect", "Essence", "Maquillaje", 285, 52.90m, "/Images/placeholder-product.png"),
        new TopProducto("Protector Solar SPF50", "La Roche-Posay", "Skincare", 210, 79.00m, "/Images/placeholder-product.png"),
    };

    private string MesTexto => meses.First(m => m.Valor == mesSeleccionado).Texto;

    private string TituloReporte => reporteActual == ReporteTipo.Ventas
        ? "Reporte de ventas"
        : "Reporte de inventario";

    private string TextoDropdown => reporteActual == ReporteTipo.Ventas
        ? "Reporte de ventas"
        : "Reporte de inventario";

    private void ToggleMenuReportes() => mostrarMenuReportes = !mostrarMenuReportes;

    private void SeleccionarReporte(ReporteTipo tipo)
    {
        reporteActual = tipo;
        mostrarMenuReportes = false;

        _ = InvokeAsync(RenderChartsAsync);
    }

    private void DescargarReporte()
    {
        // interacción mock
        // luego pueden implementarlo con export real
    }

    private record MesFiltro(int Valor, string Texto);

    private record VentasKpis(decimal Ingresos, int PedidosTotales, decimal TicketPromedio, decimal DescuentoPromedio, int CrecimientoVsMesAnterior);

    private record InventarioKpis(decimal ValorTotal, int StockCritico, int Agotados, int Saludable);

    private record TopProducto(string Nombre, string Marca, string Categoria, int CantidadVendida, decimal PrecioUnitario, string ImagenUrl);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // La primera vez, dibuja
        if (firstRender)
        {
            await RenderChartsAsync();
        }
    }

    private async Task RenderChartsAsync()
    {
        if (reporteActual == ReporteTipo.Ventas)
        {
            var labels = Enumerable.Range(1, 12).Select(d => $"{d} May").ToArray();
            var values = new[] { 50, 70, 85, 60, 95, 110, 90, 105, 80, 120, 95, 100 };

            await JS.InvokeVoidAsync("killaCharts.createOrUpdateLineChart",
                "ventasLineChart", labels, values, "Unidades vendidas");

            var labelsBar = new[] { "Abril / Semana 4", "Mayo / Semana 1", "Mayo / Semana 2", "Mayo / Semana 3" };
            var valuesBar = new[] { 90, 120, 135, 110 };

            await JS.InvokeVoidAsync("killaCharts.createOrUpdateBarChart",
                "ventasBarChart", labelsBar, valuesBar, "Unidades");
        }
        else
        {
            var labels = new[] { "SKU mov fast", "SKU promedio", "SKU lento moving", "Sin movimiento" };
            var values = new[] { 55, 45, 19, 0 };

            await JS.InvokeVoidAsync("killaCharts.createOrUpdateDonutChart",
                "inventarioDonutChart", labels, values);
        }
    }
}