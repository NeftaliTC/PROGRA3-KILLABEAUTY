@page "/admin/empleados"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Gestión de Empleados - Killa Beauty</PageTitle>

<main class="admin-page">
    <AdminNavbar />

    <section class="admin-content admin-employees-content">
        
        @* 🛡️ CONTROL DE ACCESO PERIMETRAL *@
        @if (!AuthService.EstaLogueado || AuthService.Rol != "SuperAdmin")
        {
            <div class="access-denied-container">
                <div class="access-denied-icon">
                    <i class="bi bi-shield-slash-fill"></i>
                </div>
                <h2>Acceso Restringido</h2>
                <p>
                    Lo sentimos, tu usuario actual cuenta con el rol de <strong>@(AuthService.EstaLogueado ? AuthService.Rol : "Invitado")</strong>.
                    Se requieren permisos exclusivos de <strong>SuperAdmin</strong> para gestionar el personal.
                </p>
                <a href="/admin/productos" class="admin-primary-action text-decoration-none">
                    Volver al Panel
                </a>
            </div>
        }
        else
        {
            @* 💻 VISTA PRINCIPAL (SOLO PARA SUPERADMIN) *@
            <div class="admin-breadcrumb">
                <span>SuperAdministrador</span>
                <i class="bi bi-chevron-right"></i>
                <span>Gestión de Empleados</span>
            </div>

            <header class="admin-header">
                <div>
                    <h1>Panel de Control de Personal</h1>
                    <p>Agrega colaboradores, gestiona sus roles operativos y controla los estados de acceso al sistema.</p>
                </div>
                <button class="admin-primary-action" @onclick="AbrirCrear">
                    <i class="bi bi-person-plus-fill"></i>
                    Nuevo empleado
                </button>
            </header>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="admin-alert-error">
                    <span><i class="bi bi-exclamation-circle-fill"></i> @mensajeError</span>
                    <button @onclick="() => mensajeError = null" class="btn-close-alert">X</button>
                </div>
            }

            <section class="admin-orders-filters">
                <div class="admin-orders-search" style="margin-bottom: 0;">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           placeholder="Buscar por DNI, descripcion, apellido o correo..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>
            </section>

            <section class="admin-table-card">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>DNI</th>
                            <th>Empleado / Colaborador</th>
                            <th>Correo Electrónico</th>
                            <th>Teléfono</th>
                            <th>Rol de Sistema</th>
                            <th>Estado</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (EmpleadosFiltrados.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="admin-empty-orders">
                                        <i class="bi bi-people"></i>
                                        <span>No se encontraron colaboradores registrados.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var emp in EmpleadosFiltrados)
                            {
                                <tr style="@(emp.Activo ? "" : "opacity: 0.65;")">
                                    <td style="font-weight: 700; color: var(--gray);">@emp.Dni</td>
                                    <td>
                                        <div style="display: flex; flex-direction: column;">
                                            <span style="font-weight: 800; color: #2f252a;">@emp.Nombre @emp.ApellidoPaterno</span>
                                            <small style="color: #a18893; font-size: 0.75rem;">ID: EMP-@emp.Dni.Substring(0, 4)</small>
                                        </div>
                                    </td>
                                    <td>@emp.CorreoElectronico</td>
                                    <td>@emp.Telefono</td>
                                    <td>
                                        <span class="badge-role @(emp.Rol == "SuperAdmin" ? "role-super" : "role-admin")">
                                            <i class="@(emp.Rol == "SuperAdmin" ? "bi bi-crown-fill" : "bi bi-person-badge-fill")"></i>
                                            @emp.Rol
                                        </span>
                                    </td>
                                    <td>
                                        @if (emp.Activo)
                                        {
                                            <span class="admin-status active">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="admin-status neutral">Suspendido</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <div style="display: inline-flex; gap: 8px; align-items: center;">
                                            <button class="admin-providers-btn-edit" @onclick="() => AbrirEditar(emp)">
                                                <i class="bi bi-pencil-square"></i> Editar
                                            </button>

                                            @if (emp.Activo)
                                            {
                                                <button class="btn-action-status suspend" @onclick="() => CambiarEstadoEmpleado(emp)">
                                                    <i class="bi bi-person-x"></i> Suspender
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-action-status activate" @onclick="() => CambiarEstadoEmpleado(emp)">
                                                    <i class="bi bi-person-check"></i> Activar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </section>
        }
    </section>
</main>

@* 📑 MODAL DE CREACIÓN / EDICIÓN *@
@if (mostrarFormulario)
{
    <div class="admin-modal-overlay">
        <div class="admin-modal-card" style="text-align: left; max-width: 550px;">
            <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; font-size: 1.4rem; color: #4a1525; font-weight: 700;">
                    @(esEdicion ? "Modificar Ficha de Empleado" : "Registrar Nuevo Colaborador")
                </h2>
                <button type="button" @onclick="CerrarFormulario" class="btn-close-modal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <EditForm Model="modeloFormulario" OnValidSubmit="GuardarEmpleado">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="admin-form-group">
                        <label>DNI (8 dígitos)</label>
                        <input type="text" @bind-value="modeloFormulario.Dni" required maxlength="8" disabled="@esEdicion" placeholder="Ej. 74561234" />
                    </div>

                    <div class="admin-form-group">
                        <label>Rol de Acceso</label>
                        <select @bind="modeloFormulario.Rol" class="admin-form-select" required>
                            <option value="Administrador">Administrador</option>
                            <option value="SuperAdmin">SuperAdmin (Acceso Total)</option>
                        </select>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px;">
                    <div class="admin-form-group">
                        <label>Nombres</label>
                        <input type="text" @bind-value="modeloFormulario.Nombre" required placeholder="Ej. Cielo" />
                    </div>

                    <div class="admin-form-group">
                        <label>Apellido Paterno</label>
                        <input type="text" @bind-value="modeloFormulario.ApellidoPaterno" required placeholder="Ej. Ramos" />
                    </div>
                </div>

                <div class="admin-form-group" style="margin-top: 12px;">
                    <label>Correo Institucional</label>
                    <input type="email" @bind-value="modeloFormulario.CorreoElectronico" required placeholder="Ej. cramos@killabeauty.pe" />
                </div>

                <div class="admin-form-group" style="margin-top: 12px;">
                    <label>Teléfono Celular</label>
                    <input type="text" @bind-value="modeloFormulario.Telefono" required placeholder="Ej. 987654321" />
                </div>

                <div class="admin-modal-actions" style="margin-top: 28px; justify-content: flex-end;">
                    <button type="button" class="admin-modal-btn-cancel" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="submit" class="admin-primary-action" style="box-shadow: none; min-height: 42px;">
                        <i class="bi bi-hdd-fill"></i> Preservar Datos
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private string busqueda = "";
    private string? mensajeError;
    private bool mostrarFormulario = false;
    private bool esEdicion = false;

    private EmpleadoDTO modeloFormulario = new();

    // Modelado de Datos Hardcodeado idéntico a tu lógica de persistencia planificada
    public class EmpleadoDTO
    {
        public string Dni { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string AppellidoPaterno { get; set; } = ""; // Mapeo BD alternativo
        public string ApellidoPaterno { get; set; } = "";
        public string CorreoElectronico { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Rol { get; set; } = "Administrador";
        public bool Activo { get; set; } = true;
    }

    // Datos iniciales consistentes simulados
    private List<EmpleadoDTO> listaEmpleados = new() {
        new EmpleadoDTO { Dni = "71234567", Nombre = "Killa", ApellidoPaterno = "Beauty", CorreoElectronico = "kbeauty@killabeauty.pe", Telefono = "951753852", Rol = "SuperAdmin", Activo = true },
        new EmpleadoDTO { Dni = "72345678", Nombre = "Valeria", ApellidoPaterno = "Mendoza", CorreoElectronico = "vmendoza@killabeauty.pe", Telefono = "963852741", Rol = "Administrador", Activo = true },
        new EmpleadoDTO { Dni = "45127896", Nombre = "Carlos", ApellidoPaterno = "Gómez", CorreoElectronico = "cgomez@killabeauty.pe", Telefono = "987456123", Rol = "Administrador", Activo = false }
    };

    private List<EmpleadoDTO> EmpleadosFiltrados => listaEmpleados
        .Where(e => string.IsNullOrWhiteSpace(busqueda) ||
                    e.Dni.Contains(busqueda) ||
                    e.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                    e.ApellidoPaterno.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                    e.CorreoElectronico.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void AbrirCrear()
    {
        esEdicion = false;
        mensajeError = null;
        modeloFormulario = new EmpleadoDTO { Activo = true, Rol = "Administrador" };
        mostrarFormulario = true;
    }

    private void AbrirEditar(EmpleadoDTO emp)
    {
        esEdicion = true;
        mensajeError = null;
        modeloFormulario = new EmpleadoDTO
        {
            Dni = emp.Dni,
            Nombre = emp.Nombre,
            ApellidoPaterno = emp.ApellidoPaterno,
            CorreoElectronico = emp.CorreoElectronico,
            Telefono = emp.Telefono,
            Rol = emp.Rol,
            Activo = emp.Activo
        };
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private void GuardarEmpleado()
    {
        // Validaciones de Negocio Hardcodeadas consistentes
        if (!esEdicion && listaEmpleados.Any(e => e.Dni == modeloFormulario.Dni))
        {
            mensajeError = "No se puede registrar. El número de DNI ya está asignado a otro colaborador.";
            CerrarFormulario();
            return;
        }

        if (esEdicion)
        {
            var emp = listaEmpleados.FirstOrDefault(e => e.Dni == modeloFormulario.Dni);
            if (emp != null)
            {
                emp.Nombre = modeloFormulario.Nombre;
                emp.ApellidoPaterno = modeloFormulario.ApellidoPaterno;
                emp.CorreoElectronico = modeloFormulario.CorreoElectronico;
                emp.Telefono = modeloFormulario.Telefono;
                emp.Rol = modeloFormulario.Rol;
            }
        }
        else
        {
            listaEmpleados.Add(modeloFormulario);
        }

        mensajeError = null;
        CerrarFormulario();
    }

    private void CambiarEstadoEmpleado(EmpleadoDTO emp)
    {
        // Regla de consistencia: El SuperAdmin no puede suspenderse a sí mismo por accidente
        if (emp.CorreoElectronico == AuthService.NombreUsuario || emp.Dni == "71234567")
        {
            mensajeError = "Operación denegada. No puedes suspender tu propia cuenta de SuperAdministrador activa.";
            return;
        }

        emp.Activo = !emp.Activo;
        mensajeError = null;
    }
}