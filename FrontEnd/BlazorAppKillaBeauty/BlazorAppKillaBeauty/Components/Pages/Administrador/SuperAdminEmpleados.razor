@code {
    private string busqueda = "";
    private string? mensajeError;
    private bool mostrarFormulario = false;
    private bool esEdicion = false;
    private bool cargando = true;

    // --- VARIABLES PARA EL BUSCADOR DE CORREO ---
    private string emailBusqueda = "";
    private bool clienteEncontrado = false;

    private Usuario modeloFormulario = new Usuario();
    private List<Usuario> listaEmpleados = new List<Usuario>();

    private List<Usuario> EmpleadosFiltrados => listaEmpleados
        .Where(e => string.IsNullOrWhiteSpace(busqueda) ||
                    (e.Dni != null && e.Dni.Contains(busqueda)) ||
                    (e.Nombre != null && e.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase)) ||
                    (e.ApellidoPaterno != null && e.ApellidoPaterno.Contains(busqueda, StringComparison.OrdinalIgnoreCase)) ||
                    (e.CorreoElectronico != null && e.CorreoElectronico.Contains(busqueda, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarEmpleados();
    }

    private async Task CargarEmpleados()
    {
        cargando = true;
        try
        {
            
            

            var superAdmins = await UsuarioService.ListarPorTipoUsuarioAsync(1);
            // var admins = await UsuarioService.ListarPorTipoUsuarioAsync(2);
            var trabajadores = await UsuarioService.ListarPorTipoUsuarioAsync(3);

            listaEmpleados = superAdmins
                .Concat(trabajadores)
                .ToList();
        }
        catch (Exception ex)
        {
            mensajeError = "Error de conexión: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirCrear()
    {
        esEdicion = false;
        mensajeError = null;

        // Reiniciamos las variables del buscador cada vez que abrimos el modal
        emailBusqueda = "";
        clienteEncontrado = false;

        modeloFormulario = new Usuario();
        mostrarFormulario = true;
    }

    // --- NUEVO MÉTODO PARA BUSCAR AL CLIENTE ---
    private async Task BuscarCliente()
    {
        mensajeError = null;
        clienteEncontrado = false;

        if (string.IsNullOrWhiteSpace(emailBusqueda))
        {
            mensajeError = "Por favor, ingresa un correo para buscar.";
            return;
        }

        try
        {
            var cliente = await UsuarioService.ObtenerUsuarioPorEmailAsync(emailBusqueda);

            if (cliente != null)
            {
                modeloFormulario = cliente;
                clienteEncontrado = true;
                // Le asignamos un rol predeterminado para sugerirle al SuperAdmin
                modeloFormulario.TipoUsuario = "ADMINISTRADOR";
            }
            else
            {
                mensajeError = "No se encontró ningún cliente registrado con ese correo.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al buscar el correo: " + ex.Message;
        }
    }

    private void AbrirEditar(Usuario emp)
    {
        esEdicion = true;
        mensajeError = null;
        modeloFormulario = new Usuario
        {
            Id = emp.Id,
            Dni = emp.Dni,
            Nombre = emp.Nombre,
            ApellidoPaterno = emp.ApellidoPaterno,
            CorreoElectronico = emp.CorreoElectronico,
            Telefono = emp.Telefono,
            TipoUsuario = emp.TipoUsuario,
            Activo = emp.Activo,
            Contrasena = emp.Contrasena,
            FechaNacimiento = emp.FechaNacimiento
        };
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    // CORRECCIÓN: Ahora es asíncrono y se simplificó la lógica
    private async Task GuardarEmpleado()
    {
        mensajeError = null;

        try
        {
            // Validamos que el modelo ya tenga los datos de un usuario real (que su ID no sea 0)
            if (modeloFormulario.Id == 0)
            {
                mensajeError = "Debes buscar y seleccionar un cliente válido primero.";
                return;
            }

            // Al ascender un cliente o editar un trabajador, siempre usamos Actualizar (PUT)
            await UsuarioService.ActualizarUsuarioAsync(modeloFormulario.Id, modeloFormulario);

            // CORRECCIÓN: Agregamos el await que faltaba
            await CargarEmpleados();
            CerrarFormulario();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    // CORRECCIÓN: Faltaba el 'async Task' en la firma porque usas 'await' adentro
    private async Task CambiarEstadoEmpleado(Usuario emp)
    {
        if (emp.Id == AuthService.UsuarioId)
        {
            mensajeError = "Operación denegada. No puedes suspender tu propia cuenta de SuperAdministrador activa.";
            return;
        }
        try
        {
            emp.Activo = !emp.Activo;

            await UsuarioService.ActualizarUsuarioAsync(emp.Id, emp);
            mensajeError = null;
        }
        catch (Exception ex)
        {
            emp.Activo = !emp.Activo;
            mensajeError = "Error al suspender: " + ex.Message;
        }
    }
}