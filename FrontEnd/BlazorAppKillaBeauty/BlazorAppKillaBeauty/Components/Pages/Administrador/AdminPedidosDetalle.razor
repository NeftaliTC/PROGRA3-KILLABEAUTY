@page "/admin/pedidos/detalle/{Codigo}"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Detalle pedido - Killa Beauty</PageTitle>

<main class="admin-page">
    <AdminNavbar />

    <section class="admin-content admin-order-detail-content">

        <div class="admin-breadcrumb">
            <span>Inicio</span>
            <i class="bi bi-chevron-right"></i>
            <span>Pedidos</span>
            <i class="bi bi-chevron-right"></i>
            <span>Detalles</span>
        </div>

        @if (pedido is null)
        {
            <header class="admin-order-detail-header">
                <div>
                    <h1>Detalle de pedido @Codigo</h1>
                    <p>No se encontro informacion para este pedido.</p>
                </div>

                <button type="button" class="btn-detail-outline" @onclick="Volver">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </button>
            </header>
        }
        else
        {
            <header class="admin-order-detail-header">
                <div>
                    <h1>Detalle de pedido @pedido.Codigo</h1>
                    <p>Realizado el @pedido.Fecha.ToString("dd/MM/yyyy")</p>
                </div>

                <button type="button" class="btn-detail-outline" @onclick="Volver">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </button>
            </header>

            <section class="admin-order-tracking-card">
                <div class="admin-order-tracking-top">
                    <span class="admin-order-cancel-pill @(pedido.Cancelado ? "is-cancelled" : "is-active")">
                        <i class="bi @(pedido.Cancelado ? "bi-x-circle-fill" : "bi-check-circle-fill")"></i>
                        @(pedido.Cancelado ? "Pedido cancelado" : "Pedido no cancelado")
                    </span>
                    <span class="admin-order-current-status">@pedido.Estado</span>
                </div>

                <div class="admin-order-progress" aria-label="Estado del pedido">
                    @foreach (var estado in estadosProgreso)
                    {
                        <div class="admin-order-progress-step @GetProgressClass(estado)">
                            <span class="progress-dot"></span>
                            <span>@estado</span>
                        </div>
                    }
                </div>
            </section>

            <section class="admin-order-detail-grid">
                <article class="admin-order-summary-card admin-order-panel">
                    <div class="panel-heading">
                        <i class="bi bi-bag-check"></i>
                        <h2>Resumen de pedido</h2>
                    </div>

                    <div class="admin-order-products">
                        @foreach (var item in pedido.Productos)
                        {
                            <div class="admin-order-product-row">
                                <img src="@item.Imagen" alt="@item.Nombre" />
                                <div class="product-info">
                                    <strong>@item.Nombre</strong>
                                    <span>@item.Marca</span>
                                </div>
                                <span>@item.Cantidad u.</span>
                                <span>S/ @item.PrecioUnitario.ToString("F2")</span>
                                <strong>S/ @item.Subtotal.ToString("F2")</strong>
                            </div>
                        }
                    </div>

                    <div class="admin-order-totals">
                        <div>
                            <span>Subtotal</span>
                            <strong>S/ @pedido.Subtotal.ToString("F2")</strong>
                        </div>
                        <div class="discount-line">
                            <span>Descuentos aplicados</span>
                            <strong>- S/ @pedido.Descuento.ToString("F2")</strong>
                        </div>
                        <div>
                            <span>Costo de envio</span>
                            <strong>S/ @pedido.CostoEnvio.ToString("F2")</strong>
                        </div>
                        <div class="total-line">
                            <span>Total final</span>
                            <strong>S/ @pedido.Total.ToString("F2")</strong>
                        </div>
                    </div>
                </article>

                <aside class="admin-order-side-panels">
                    <article class="admin-order-panel">
                        <div class="panel-heading">
                            <i class="bi bi-person"></i>
                            <h2>Cliente</h2>
                        </div>

                        <div class="admin-order-info-list">
                            <div><span>Nombre de usuario</span><strong>@pedido.Cliente.NombreUsuario</strong></div>
                            <div><span>Correo</span><strong>@pedido.Cliente.Correo</strong></div>
                            <div><span>Contacto</span><strong>@pedido.Cliente.Contacto</strong></div>
                        </div>
                    </article>

                    <article class="admin-order-panel">
                        <div class="panel-heading">
                            <i class="bi bi-geo-alt"></i>
                            <h2>Direccion de envio</h2>
                        </div>

                        <div class="admin-order-info-list">
                            <div><span>Direccion</span><strong>@pedido.Envio.Direccion</strong></div>
                            <div><span>Referencia</span><strong>@pedido.Envio.Referencia</strong></div>
                            <div><span>Coordenadas</span><strong>@pedido.Envio.Coordenadas</strong></div>
                        </div>
                    </article>

                    <article class="admin-order-panel">
                        <div class="panel-heading">
                            <i class="bi bi-credit-card"></i>
                            <h2>Metodo de pago</h2>
                        </div>

                        <div class="admin-order-info-list">
                            <div><span>Tipo</span><strong>@pedido.Pago.Tipo</strong></div>
                            <div><span>Operacion</span><strong>@pedido.Pago.Operacion</strong></div>
                            <div><span>Detalle</span><strong>@pedido.Pago.Detalle</strong></div>
                        </div>
                    </article>
                </aside>
            </section>

            <footer class="admin-order-detail-actions">
                <button type="button">
                    <i class="bi bi-printer"></i>
                    Imprimir comprobante
                </button>
                <button type="button">
                    <i class="bi bi-download"></i>
                    Descargar comprobante
                </button>
                <button type="button">
                    <i class="bi bi-share"></i>
                    Compartir comprobante
                </button>
            </footer>
        }

    </section>
</main>

@code {
    [Parameter] public string Codigo { get; set; } = "";

    private PedidoDetalleAdmin? pedido;
    private readonly List<string> estadosProgreso = new() { "Pendiente", "Pagado", "En preparación", "Enviado", "Entregado" };

    protected override void OnInitialized()
    {
        pedido = ObtenerPedidosMock().FirstOrDefault(p => p.Codigo == Codigo);
    }

    private void Volver() => Navigation.NavigateTo("/admin/pedidos");

    private string GetProgressClass(string estado)
    {
        if (pedido is null || pedido.Cancelado)
        {
            return "disabled";
        }

        var estadosNormalizados = estadosProgreso.Select(NormalizarEstado).ToList();
        var indiceActual = estadosNormalizados.IndexOf(NormalizarEstado(pedido.Estado));
        var indicePaso = estadosNormalizados.IndexOf(NormalizarEstado(estado));

        if (indiceActual == indicePaso)
        {
            return "active";
        }

        return indiceActual > indicePaso ? "completed" : "";
    }

    private static string NormalizarEstado(string estado)
    {
        return estado == "En preparación" ? "En preparacion" : estado;
    }

