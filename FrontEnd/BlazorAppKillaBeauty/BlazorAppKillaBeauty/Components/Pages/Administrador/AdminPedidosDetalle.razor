    };

    private record PedidoDetalleAdmin(
        string Codigo,
        DateTime Fecha,
        string Estado,
        bool Cancelado,
        ClientePedido Cliente,
        EnvioPedido Envio,
        PagoPedido Pago,
        decimal Descuento,
        decimal CostoEnvio,
        List<ProductoPedido> Productos)
    {
        public decimal Subtotal => Productos.Sum(p => p.Subtotal);
        public decimal Total => Subtotal - Descuento + CostoEnvio;
    }

    private record ProductoPedido(string Nombre, string Marca, string Imagen, int Cantidad, decimal PrecioUnitario)
    {
        public decimal Subtotal => Cantidad * PrecioUnitario;
    }

    private record ClientePedido(string NombreUsuario, string Correo, string Contacto);
    private record EnvioPedido(string Direccion, string Referencia, string Coordenadas);
    private record PagoPedido(string Tipo, string Detalle, string Operacion);
}
