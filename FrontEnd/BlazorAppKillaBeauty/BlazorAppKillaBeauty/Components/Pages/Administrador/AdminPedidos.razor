@page "/admin/pedidos"
@rendermode InteractiveServer

<PageTitle>Pedidos Admin - Killa Beauty</PageTitle>

<main class="admin-page">
    <AdminNavbar />

    <section class="admin-content admin-orders-content">

        <div class="admin-breadcrumb">
            <span>Inicio</span>
            <i class="bi bi-chevron-right"></i>
            <span>Pedidos</span>
        </div>

        <header class="admin-header admin-orders-header">
            <div>
                <h1>Pedidos</h1>
                <p>Consulta y filtra las compras registradas en la tienda.</p>
            </div>
        </header>

        <section class="admin-orders-filters">
            <div class="admin-orders-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por pedido, cliente o correo"
                       @bind="busqueda"
                       @bind:event="oninput" />
            </div>

            <div class="admin-orders-filter-row">
                <div class="admin-date-group">
                    <span>Fecha inicial</span>
                    <div class="admin-date-picker">
                        <input type="date"
                               class="form-control"
                               max="@FechaInicioMaxima"
                               @bind="fechaInicio" />
                    </div>
                </div>

                <div class="admin-date-group">
                    <span>Fecha final</span>
                    <div class="admin-date-picker">
                        <input type="date"
                               class="form-control"
                               min="@FechaFinMinima"
                               @bind="fechaFin" />
                    </div>
                </div>

                <div class="admin-status-filter">
                    <span>Estado de envio</span>
                    <select @bind="estadoSeleccionado">
                        <option value="Cualquier estado">Cualquier estado</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Pagado">Pagado</option>
                        <option value="En preparación">En preparación</option>
                        <option value="Enviado">Enviado</option>
                        <option value="Entregado">Entregado</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                </div>

                <button type="button"
                        class="admin-clear-filters"
                        @onclick="LimpiarFiltros">
                    <i class="bi bi-x-circle"></i>
                    Limpiar filtros
                </button>
            </div>
        </section>

        <section class="admin-table-card admin-orders-table-card">
            <table class="admin-table admin-orders-table">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Cliente</th>
                        <th>Correo</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Estado de envio</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PedidosPaginados.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="admin-empty-orders">
                                    <i class="bi bi-inbox"></i>
                                    <span>No se encontraron pedidos con esos filtros.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pedido in PedidosPaginados)
                        {
                            <tr>
                                <td>@pedido.Id</td>
                                <td>@pedido.Cliente</td>
                                <td>@pedido.Correo</td>
                                <td>@pedido.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>S/ @pedido.Total.ToString("F2")</td>
                                <td>
                                    <span class="admin-status @pedido.ClaseEstado">
                                        @pedido.EstadoEnvio
                                    </span>
                                </td>
                                <td>
                                    <div class="admin-order-actions">
                                        <a href="/admin/pedidos/detalle/@pedido.Id"
                                           class="admin-detail-button">
                                            <i class="bi bi-eye"></i>
                                            Ver
                                        </a>

                                        <button type="button"
                                                class="admin-cancel-order-button"
                                                @onclick="() => AbrirModalCancelacion(pedido)">
                                            <i class="bi bi-x-circle"></i>
                                            Cancelar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>

        <footer class="admin-pagination">
            <span>
                Pagina @paginaActual de @TotalPaginas
            </span>

            <div class="admin-pagination-buttons">
                <button type="button"
                        disabled="@(paginaActual == 1)"
                        @onclick="PaginaAnterior">
                    <i class="bi bi-chevron-left"></i>
                </button>

                @for (var pagina = 1; pagina <= TotalPaginas; pagina++)
                {
                    var numeroPagina = pagina;

                    <button type="button"
                            class="@(paginaActual == numeroPagina ? "active" : "")"
                            @onclick="() => CambiarPagina(numeroPagina)">
                        @numeroPagina
                    </button>
                }

                <button type="button"
                        disabled="@(paginaActual == TotalPaginas)"
                        @onclick="PaginaSiguiente">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </footer>

    </section>
</main>

@if (mostrarModalCancelacion && pedidoCancelacion is not null)
{
    <div class="admin-order-warning-overlay" @onclick="CerrarModalCancelacion">
        <section class="admin-order-warning-card" @onclick:stopPropagation="true">
            <div class="admin-order-warning-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            @if (modoCancelacion == ModoCancelacion.Bloqueado)
            {
                <h2>No se puede cancelar el pedido</h2>
                <p>
                    El pedido <strong>@pedidoCancelacion.Id</strong> no se puede cancelar porque ya est&aacute;
                    <strong>@pedidoCancelacion.EstadoEnvio.ToLowerInvariant()</strong>.
                    @if (RequiereReembolso(pedidoCancelacion))
                    {
                        <span>Adem&aacute;s, har&aacute; falta gestionar el refund o reembolso del pago.</span>
                    }
                </p>

                <div class="admin-order-warning-actions single">
                    <button type="button" class="admin-order-warning-confirm" @onclick="CerrarModalCancelacion">
                        Entendido
                    </button>
                </div>
            }
            else if (modoCancelacion == ModoCancelacion.YaCancelado)
            {
                <h2>Pedido ya cancelado</h2>
                <p>
                    El pedido <strong>@pedidoCancelacion.Id</strong> ya se encuentra marcado como cancelado.
                </p>

                <div class="admin-order-warning-actions single">
                    <button type="button" class="admin-order-warning-confirm" @onclick="CerrarModalCancelacion">
                        Entendido
                    </button>
                </div>
            }
            else
            {
                <h2>&iquest;Cancelar pedido?</h2>
                <p>
                    El pedido <strong>@pedidoCancelacion.Id</strong> cambiar&aacute; su estado a
                    <strong>Cancelado</strong>. &iquest;Deseas continuar?
                    @if (RequiereReembolso(pedidoCancelacion))
                    {
                        <span>Este pedido ya fue pagado, por lo que har&aacute; falta gestionar el refund o reembolso.</span>
                    }
                </p>

                <div class="admin-order-warning-actions">
                    <button type="button" class="admin-order-warning-cancel" @onclick="CerrarModalCancelacion">
                        No
                    </button>
                    <button type="button" class="admin-order-warning-confirm" @onclick="ConfirmarCancelacionPedido">
                        S&iacute;
                    </button>
                </div>
            }
        </section>
    </div>
}

@code {
    private string busqueda = "";
    private string estadoSeleccionado = "Cualquier estado";

    private DateTime? fechaInicio;
    private DateTime? fechaFin;

    private PedidoAdmin? pedidoCancelacion;
    private ModoCancelacion modoCancelacion = ModoCancelacion.Confirmar;
    private bool mostrarModalCancelacion = false;

    private int paginaActual = 1;
    private const int PedidosPorPagina = 5;

    private string? FechaInicioMaxima => fechaFin?.ToString("yyyy-MM-dd");
    private string? FechaFinMinima => fechaInicio?.ToString("yyyy-MM-dd");

    private List<PedidoAdmin> pedidos = new()
    {
        new PedidoAdmin("KIL-202610081", "Cliente", "cliente@correo.com", new DateTime(2026, 5, 30), 159.80m, "En preparación", "warning"),
        new PedidoAdmin("KIL-202605002", "Maria Lopez", "maria.lopez@correo.com", new DateTime(2026, 5, 25), 178.20m, "Entregado", "active"),
        new PedidoAdmin("KIL-202604115", "Ana Torres", "ana.torres@correo.com", new DateTime(2026, 5, 10), 120.00m, "Pagado", "info"),
        new PedidoAdmin("KIL-202604086", "Luis Perez", "luis.perez@correo.com", new DateTime(2026, 4, 28), 89.90m, "Enviado", "info"),
        new PedidoAdmin("KIL-202604033", "Camila Rios", "camila.rios@correo.com", new DateTime(2026, 4, 18), 245.70m, "Pendiente", "warning"),
        new PedidoAdmin("KIL-202603021", "Sofia Castro", "sofia.castro@correo.com", new DateTime(2026, 3, 9), 52.90m, "Cancelado", "danger"),
        new PedidoAdmin("KIL-202602014", "Valeria Diaz", "valeria.diaz@correo.com", new DateTime(2026, 2, 14), 302.40m, "Entregado", "active")
    };

    private List<PedidoAdmin> PedidosFiltrados =>
        pedidos
            .Where(CoincideBusqueda)
            .Where(CoincideEstado)
            .Where(CoincideFechaInicio)
            .Where(CoincideFechaFin)
            .OrderByDescending(p => p.Fecha)
            .ToList();

    private List<PedidoAdmin> PedidosPaginados =>
        PedidosFiltrados
            .Skip((paginaActual - 1) * PedidosPorPagina)
            .Take(PedidosPorPagina)
            .ToList();

    private int TotalPaginas =>
        Math.Max(1, (int)Math.Ceiling(PedidosFiltrados.Count / (double)PedidosPorPagina));

    private bool CoincideBusqueda(PedidoAdmin pedido)
    {
        if (string.IsNullOrWhiteSpace(busqueda))
        {
            return true;
        }

        return pedido.Id.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
               pedido.Cliente.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
               pedido.Correo.Contains(busqueda, StringComparison.OrdinalIgnoreCase);
    }

    private bool CoincideEstado(PedidoAdmin pedido)
    {
        return estadoSeleccionado == "Cualquier estado" ||
               pedido.EstadoEnvio == estadoSeleccionado;
    }

    private bool CoincideFechaInicio(PedidoAdmin pedido)
    {
        return fechaInicio is null || pedido.Fecha.Date >= fechaInicio.Value.Date;
    }

    private bool CoincideFechaFin(PedidoAdmin pedido)
    {
        return fechaFin is null || pedido.Fecha.Date <= fechaFin.Value.Date;
    }

    private void LimpiarFiltros()
    {
        busqueda = "";
        estadoSeleccionado = "Cualquier estado";
        fechaInicio = null;
        fechaFin = null;
        paginaActual = 1;
    }

    private void CambiarPagina(int pagina)
    {
        paginaActual = pagina;
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < TotalPaginas)
        {
            paginaActual++;
        }
    }

    private void AbrirModalCancelacion(PedidoAdmin pedido)
    {
        pedidoCancelacion = pedido;
        modoCancelacion = pedido.EstadoEnvio switch
        {
            "Enviado" or "Entregado" => ModoCancelacion.Bloqueado,
            "Cancelado" => ModoCancelacion.YaCancelado,
            _ => ModoCancelacion.Confirmar
        };
        mostrarModalCancelacion = true;
    }

    private void CerrarModalCancelacion()
    {
        mostrarModalCancelacion = false;
        pedidoCancelacion = null;
    }

    private void ConfirmarCancelacionPedido()
    {
        if (pedidoCancelacion is null)
        {
            return;
        }

        pedidoCancelacion.EstadoEnvio = "Cancelado";
        pedidoCancelacion.ClaseEstado = "danger";
        CerrarModalCancelacion();
    }

    private static bool RequiereReembolso(PedidoAdmin pedido)
    {
        return pedido.EstadoEnvio is "Pagado" or "En preparaciÃ³n" or "Enviado" or "Entregado";
    }

    private enum ModoCancelacion
    {
        Confirmar,
        Bloqueado,
        YaCancelado
    }

    private class PedidoAdmin
    {
        public PedidoAdmin(
            string id,
            string cliente,
            string correo,
            DateTime fecha,
            decimal total,
            string estadoEnvio,
            string claseEstado)
        {
            Id = id;
            Cliente = cliente;
            Correo = correo;
            Fecha = fecha;
            Total = total;
            EstadoEnvio = estadoEnvio;
            ClaseEstado = claseEstado;
        }

        public string Id { get; }
        public string Cliente { get; }
        public string Correo { get; }
        public DateTime Fecha { get; }
        public decimal Total { get; }
        public string EstadoEnvio { get; set; }
        public string ClaseEstado { get; set; }
    }
}
