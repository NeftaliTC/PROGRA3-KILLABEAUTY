@page "/admin/proveedores"
@rendermode InteractiveServer

<PageTitle>Proveedores Admin - Killa Beauty</PageTitle>

<main class="admin-page">
    <AdminNavbar />

    <section class="admin-content admin-providers-content">
        
        <div class="admin-breadcrumb">
            <span>Administrador</span>
            <i class="bi bi-chevron-right"></i>
            <span>Proveedores</span>
        </div>

        <header class="admin-header">
            <div>
                <h1>Proveedores Logísticos</h1>
                <p>Gestiona los servicios de transporte y asigna el courier exclusivo para los envíos.</p>
            </div>
            <button class="admin-primary-action" @onclick="AbrirCrear">
                <i class="bi bi-plus-circle"></i>
                Nuevo proveedor
            </button>
        </header>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="admin-empty-orders" style="min-height: auto; padding: 12px; background: #ffe0e0; color: #a12828; border-radius: 12px; margin-bottom: 16px; justify-content: space-between;">
                <span><i class="bi bi-exclamation-circle-fill"></i> @mensajeError</span>
                <button @onclick="() => mensajeError = null" style="background: transparent; border: none; color: #a12828; cursor: pointer; font-weight: bold;">X</button>
            </div>
        }

        <section class="admin-orders-filters">
            <div class="admin-orders-search" style="margin-bottom: 0;">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por proveedor, RUC o correo..."
                       @bind="busqueda"
                       @bind:event="oninput" />
            </div>
        </section>

        <section class="admin-table-card">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>RUC</th>
                        <th>Correo de Contacto</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (CouriersFiltrados.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty-orders">
                                    <i class="bi bi-inbox"></i>
                                    <span>No se encontraron proveedores.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var courier in CouriersFiltrados)
                        {
                            <tr style="@(courier.activo ? "" : "opacity: 0.85;")">
                                <td style="font-weight: 800;">@courier.Nombre</td>
                                <td>@courier.RUC</td>
                                <td>@courier.correo</td>
                                <td>@courier.telefono</td>
                                <td>
                                    @if (courier.activo)
                                    {
                                        <span class="admin-status active">Asignado</span>
                                    }
                                    else
                                    {
                                        <span class="admin-status neutral">No Asignado</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: inline-flex; gap: 8px; align-items: center;">
                                        <button class="admin-providers-btn-edit" @onclick="() => AbrirEditar(courier)">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </button>

                                        @if (courier.activo)
                                        {
                                            <span class="admin-providers-txt-active">
                                                <i class="bi bi-check-circle-fill"></i> Actual
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="admin-providers-btn-assign" @onclick="() => AbrirConfirmacion(courier)">
                                                Asignar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>
    </section>
</main>

@if (mostrarFormulario)
{
    <div class="admin-modal-overlay">
        <div class="admin-modal-card" style="text-align: left; max-width: 500px;">
            <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; font-size: 1.4rem;">
                    @(esEdicion ? "Editar Proveedor" : "Nuevo Proveedor")
                </h2>
                <button type="button" @onclick="CerrarFormulario" style="background: transparent; border: none; font-size: 1.3rem; color: var(--gray); cursor: pointer;">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <EditForm Model="modeloFormulario" OnValidSubmit="GuardarProveedor">
                <div class="admin-form-group">
                    <label>Nombre del Proveedor</label>
                    <input type="text" @bind-value="modeloFormulario.Nombre" required placeholder="Ej. Olva Courier" />
                </div>

                <div class="admin-form-group">
                    <label>RUC (11 dígitos)</label>
                    <input type="text" @bind-value="modeloFormulario.RUC" required maxlength="11" placeholder="Ej. 20512345678" />
                </div>

                <div class="admin-form-group">
                    <label>Correo Electrónico de Contacto</label>
                    <input type="email" @bind-value="modeloFormulario.correo" required placeholder="Ej. contacto@olva.com.pe" />
                </div>

                <div class="admin-form-group">
                    <label>Teléfono de Contacto</label>
                    <input type="text" @bind-value="modeloFormulario.telefono" required placeholder="Ej. 01-234-5678" />
                </div>

                <div class="admin-modal-actions" style="margin-top: 28px; justify-content: flex-end;">
                    <button type="button" class="admin-modal-btn-cancel" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="submit" class="admin-primary-action" style="box-shadow: none; min-height: 42px;">
                        <i class="bi bi-download"></i> Guardar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (mostrarModalAsignar && courierSeleccionado != null)
{
    <div class="admin-modal-overlay">
        <div class="admin-modal-card">
            <div class="admin-modal-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h2>¿Cambiar proveedor logístico?</h2>
            
            <p class="admin-modal-text">
                El proveedor <strong style="color: #2f252a;">@courierActual?.Nombre</strong> dejará de estar asignado.
                A partir de ahora, <strong style="color: var(--rose);">@courierSeleccionado.Nombre</strong> se encargará de manera exclusiva de los envíos.
            </p>
            
            <div class="admin-modal-actions">
                <button class="admin-modal-btn-cancel" @onclick="CerrarModalAsignar">Cancelar</button>
                <button class="admin-modal-btn-confirm" @onclick="ConfirmarCambio">Confirmar Cambio</button>
            </div>
        </div>
    </div>
}

@code {
    private string busqueda = "";
    private string? mensajeError;
    private bool mostrarModalAsignar = false;
    private bool mostrarFormulario = false;
    private bool esEdicion = false;

    private Courier? courierSeleccionado;
    private Courier modeloFormulario = new();

    // Estructura idéntica a tu BD
    private class Courier
    {
        public int Id_courier { get; set; }
        public string Nombre { get; set; } = "";
        public string RUC { get; set; } = "";
        public string correo { get; set; } = "";
        public string telefono { get; set; } = "";
        public bool activo { get; set; } = false; // Por defecto entran como false (No asignados)
    }

    private List<Courier> couriers = new() {
        new Courier { Id_courier = 1, Nombre = "Olva Courier", RUC = "20512345678", correo = "atencion@olva.com.pe", telefono = "01-234-5678", activo = true }
    };

    private Courier? courierActual => couriers.FirstOrDefault(c => c.activo);

    private List<Courier> CouriersFiltrados => couriers
        .Where(c => string.IsNullOrWhiteSpace(busqueda) ||
                    c.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                    c.RUC.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                    c.correo.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void AbrirCrear()
    {
        esEdicion = false;
        mensajeError = null;
        modeloFormulario = new Courier { activo = false };
        mostrarFormulario = true;
    }

    private void AbrirEditar(Courier courier)
    {
        esEdicion = true;
        mensajeError = null;
        modeloFormulario = new Courier
        {
            Id_courier = courier.Id_courier,
            Nombre = courier.Nombre,
            RUC = courier.RUC,
            correo = courier.correo,
            telefono = courier.telefono,
            activo = courier.activo
        };
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private void GuardarProveedor()
    {
        if (esEdicion)
        {
            var item = couriers.FirstOrDefault(c => c.Id_courier == modeloFormulario.Id_courier);
            if (item != null)
            {
                item.Nombre = modeloFormulario.Nombre;
                item.RUC = modeloFormulario.RUC;
                item.correo = modeloFormulario.correo;
                item.telefono = modeloFormulario.telefono;
                // El campo activo se mantiene como estaba, no se edita en este modal
            }
        }
        else
        {
            modeloFormulario.Id_courier = couriers.Any() ? couriers.Max(c => c.Id_courier) + 1 : 1;
            couriers.Add(modeloFormulario);
        }

        mensajeError = null;
        CerrarFormulario();
    }

    private void AbrirConfirmacion(Courier courier)
    {
        courierSeleccionado = courier;
        mostrarModalAsignar = true;
    }

    private void CerrarModalAsignar()
    {
        mostrarModalAsignar = false;
        courierSeleccionado = null;
    }

    private void ConfirmarCambio()
    {
        if (courierSeleccionado != null)
        {
            // Lógica que mapea perfecto a tu BD: Solo 1 en true, el resto en false
            foreach (var c in couriers)
            {
                c.activo = (c.Id_courier == courierSeleccionado.Id_courier);
            }
        }
        CerrarModalAsignar();
    }
}