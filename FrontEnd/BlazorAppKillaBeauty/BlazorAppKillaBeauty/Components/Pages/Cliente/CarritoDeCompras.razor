@page "/cart"
@rendermode InteractiveServer
@using BlazorAppKillaBeauty.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject CartService CartService

<Navbar CantidadCarrito="@CantidadCarrito" />

<section class="cart-page">

    @if (CartService.Productos.Count == 0)
    {
        <div class="empty-cart-wrapper">

            <div class="empty-cart">

                <i class="bi bi-bag empty-cart-icon"></i>

                <h1>Tu carrito está vacío</h1>

                <p>Agrega productos para comenzar tu compra</p>

                <NavLink href="/" class="cart-button">
                    Explorar productos
                </NavLink>

            </div>

        </div>
    }
    else
    {
        <div class="cart-container">

            <div class="cart-list">

                <h1>Carrito de Compras</h1>

                @foreach (var producto in CartService.Productos)
                {
                    <div class="cart-item">

                        <img src="@producto.Imagen"
                             alt="@producto.Nombre"
                             class="cart-item-img" />

                        <div class="cart-item-info">
                            <h3>@producto.Nombre</h3>

                            <div class="discount-line">
                                <span class="cart-tag">
                                    @producto.TipoCompra
                                </span>

                                @if (producto.PrecioUnitario < producto.PrecioOriginal)
                                {
                                    <span class="saving-text">
                                        ↝ Ahorro: S/ @((producto.PrecioOriginal - producto.PrecioUnitario).ToString("0.00"))
                                    </span>
                                }
                            </div>

                            <p class="unit-price">
                                Precio unitario:
                                S/ @producto.PrecioUnitario.ToString("0.00")

                                @if (producto.PrecioUnitario < producto.PrecioOriginal)
                                {
                                    <span class="old-price">
                                        S/ @producto.PrecioOriginal.ToString("0.00")
                                    </span>

                                    <span class="off-text">
                                        (@producto.PorcentajeDescuento% OFF)
                                    </span>
                                }
                            </p>
                        </div>

                        <div class="cart-actions">
                            <button @onclick="() => CartService.DisminuirCantidad(producto.Nombre)">
                                -
                            </button>

                            <span>@producto.Cantidad</span>

                            <button @onclick="() => CartService.AumentarCantidad(producto.Nombre)">
                                +
                            </button>
                        </div>

                        <div class="cart-subtotal">
                            <small>Subtotal</small>
                            <strong>
                                S/ @producto.Subtotal.ToString("0.00")
                            </strong>
                        </div>

                        <button class="delete-btn"
                                @onclick="() => CartService.EliminarProducto(producto.Nombre)">
                            <i class="bi bi-trash"></i>
                        </button>

                    </div>
                }

            </div>

            <div class="cart-summary">
                <h2>Resumen del Pedido</h2>

                <div class="summary-row">
                    <span>Subtotal productos</span>
                    <strong>S/ @CartService.Total.ToString("0.00")</strong>
                </div>

                @if (CartService.DescuentoTotal > 0)
                {
                    <div class="summary-row discount">
                        <span>Descuento por volumen</span>
                        <strong>S/ @CartService.DescuentoTotal.ToString("0.00")</strong>
                    </div>
                }

                <hr />

                <div class="summary-total">
                    <span>Total a pagar</span>
                    <strong>S/ @CartService.Total.ToString("0.00")</strong>
                </div>

                @if (AuthService.EstaLogueado)
                {
                    <button class="pay-button"
                            @onclick="ProcederPago">
                        Proceder al pago
                    </button>
                }
                else
                {
                    <button class="pay-button"
                            @onclick="IrLogin">
                        Iniciar sesión para continuar
                    </button>
                }

                <NavLink href="/" class="continue-link">
                    Continuar comprando
                </NavLink>
            </div>

        </div>
    }

</section>

@code {
    private int CantidadCarrito => CartService.CantidadTotal;

    private IReadOnlyList<CartItem> productosCarrito =>
        CartService.Productos;

    private decimal Total => CartService.Total;

    private string mensajeError = "";

    private void ProcederPago()
    {
        Navigation.NavigateTo("/checkout");
    }

    private void IrLogin()
    {
        Navigation.NavigateTo("/login?returnUrl=/cart");
    }
}