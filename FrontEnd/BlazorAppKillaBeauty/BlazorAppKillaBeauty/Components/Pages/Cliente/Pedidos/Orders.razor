@page "/orders"
@rendermode InteractiveServer
@using BlazorAppKillaBeauty.ClienteREST.ServicesAct
@using BlazorAppKillaBeauty.Services
@inject CartService CartService

<Navbar CantidadCarrito="@CartService.CantidadTotal" />

<div class="orders-page-container">
    <section class="orders-header">
        <h1>Mis pedidos</h1>
        <p>@pedidos.Count pedido(s) realizado(s)</p>
    </section>

    @if (pedidos.Count == 0)
    {
        <div class="empty-state-card">
            <i class="bi bi-box"></i>
            <p>Aún no tienes pedidos realizados.</p>
            <a href="/" class="btn-shop-solid">Ir a comprar</a>
        </div>
    }
    else
    {
        <section class="orders-list">
            @foreach (var p in pedidos)
            {
                <div class="order-card">
                    <div class="card-header">
                        <span class="date">@p.Fecha</span>
                        <span class="status-badge @p.ClaseEstado">@p.Estado</span>
                    </div>
                    
                    <h3>Pedido @p.Id</h3>
                    
                    <div class="product-preview">
                        @* Mostramos máximo 3 imágenes *@
                        @foreach (var prod in p.Productos.Take(3))
                        {
                            <img src="@prod.Imagen" alt="Producto" class="thumb" />
                        }
    
                        @* Si hay más de 3, mostramos el contador +N *@
                        @if (p.Productos.Count > 3)
                        {
                            <div class="more-items">+@(p.Productos.Count - 3)</div>
                        }
                    </div>

                    <div class="order-footer">
                        <div class="order-info-group">
                            <span class="item-count">@p.TotalArticulos artículo(s)</span>
                            <span class="total-price">S/ @p.TotalPrecio.ToString("F2")</span>
                        </div>
    
                        <a href="/orders/order-detail/@p.Id" class="btn-outline-order-detail">Ver detalle ></a>
                    </div>
                </div>
            }
        </section>
    }
</div>

@code {

    private string GetStatusClass(string activo) => activo switch
    {
        "Entregado" => "status-green",
        "En camino" => "status-purple",
        "En preparación" => "status-orange",
        "Pedido confirmado" => "status-yellow",
        _ => "status-default"
    };
    
    public class Pedido
    {
        public string Id { get; set; }
        public string Fecha { get; set; }
        public string Estado { get; set; }
        public string ClaseEstado { get; set; }
        public int TotalArticulos { get; set; }
        public List<Producto> Productos { get; set; } = new();
        public decimal TotalPrecio { get; set; }
    }

    public class Producto
    {
        public string Imagen { get; set; }
    }
    
    private List<Pedido> pedidos = new()
