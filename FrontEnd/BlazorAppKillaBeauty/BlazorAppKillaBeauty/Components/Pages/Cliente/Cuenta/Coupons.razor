@page "/account/coupons"
@layout AccountLayout
@rendermode InteractiveServer

<div class="account-content-inner">
    <h2 class="content-section-title">Cupones Disponibles</h2>

    <div class="coupons-list">
    @foreach (var cupon in listaCupones)
    {
        <div class="ticket-card">
            <div class="cutout-container left">
                <div class="ticket-side-pink"></div>
                <div class="cutout-shape"></div>
            </div>
            
            <div class="ticket-main-content">
                <h3 class="ticket-title">@cupon.Titulo</h3>
                <p class="ticket-subtitle grey-text">
                    @((MarkupString)cupon.Subtitulo)<br />
                    Cupón: @cupon.Codigo</p>
                <div class="ticket-separator"></div>
                <div class="ticket-footer grey-text">
                    <span><i class="bi bi-clock"></i> Vence @cupon.FechaFin.ToString("d 'de' MMMM", new System.Globalization.CultureInfo("es-ES"))</span>
                    <button class="ver-btn" @onclick='() => MostrarModal(cupon)'>Ver</button>
                </div>
            </div>

            <div class="cutout-container right">
                <div class="ticket-side-pink"></div>
                <div class="cutout-shape"></div>
            </div>
        </div>
    }
</div>
</div>

@if (mostrarModal && cuponSeleccionado != null)
{
    <div class="modal-backdrop-transparent fade-in" @onclick="CerrarModal">
        <div class="modal-content-wrapper scale-up" @onclick:stopPropagation="true">
            <button class="modal-close-x" @onclick="CerrarModal">×</button>
            <h3 class="modal-title">@cuponSeleccionado.Titulo</h3>
            <div class="modal-body-text">
                @cuponSeleccionado.DescripcionLegal
            </div>
        </div>
    </div>
}

@code {
    private List<Cupon> listaCupones = new();

    protected override void OnInitialized()
    {
        listaCupones = new List<Cupon> {
            new Cupon { Codigo = "MAMA20",
                        Titulo = "20% OFF Día de la Madre", 
                        Subtitulo = "Compra mínima S/ 100<br />Tope S/ 30", 
                        FechaFin = new DateTime(2026, 5, 12),
                        DescripcionLegal = "CAMPAÑA DÍA DE LA MADRE 2026. Beneficio válido únicamente para compras realizadas a través de la tienda virtual desde el 07/05/2026 hasta el 12/05/2026, incluyendo ambas fechas; o hasta agotar el stock de cupones disponibles; o hasta alcanzar el monto máximo destinado a descuentos de la campaña, lo que ocurra primero. El beneficio consiste en un 20% de descuento sobre el total de la compra, con una compra mínima de S/. 100 y un tope máximo de descuento de S/. 30 por usuario. El cupón MAMA20 es válido para una sola compra por usuario y no es acumulable con otras promociones, descuentos, beneficios o cupones vigentes. La campaña aplica únicamente para compras virtuales y está sujeta a disponibilidad, validación del pedido y condiciones comerciales de la tienda." },
            new Cupon { Codigo = "BIENVENIDO",
                        Titulo = "S/. 15 OFF primera compra", 
                        Subtitulo = "Compra mínima S/ 15", 
                        FechaFin = new DateTime(2026, 12, 31),
                        DescripcionLegal = "CAMPAÑA BIENVENIDA 2026. Beneficio válido únicamente para nuevos usuarios que realicen su primera compra a través de la tienda virtual desde el 01/01/2026 hasta el 31/12/2026; o hasta agotar el stock de cupones disponibles; o hasta alcanzar el monto máximo destinado a descuentos de la campaña, lo que ocurra primero. El beneficio consiste en un descuento directo de S/. 15 sobre el total de la compra, con una compra mínima de S/. 75. El cupón BIENVENIDO2026 es válido para una sola compra por usuario y no es acumulable con otras promociones, descuentos, beneficios o cupones vigentes. La campaña aplica únicamente para compras virtuales y está sujeta a disponibilidad, validación del pedido y condiciones comerciales de la tienda." },
            new Cupon { Codigo = "CYBERWOW",
                        Titulo = "30% OFF CyberWOW", 
                        Subtitulo = "Compra mínima S/ 250<br />Tope S/ 100",
                        FechaFin = new DateTime(2026, 10, 14),
                        DescripcionLegal = "CAMPAÑA CYBERWOW 2026. Beneficio válido únicamente para compras realizadas a través de la tienda virtual durante las fechas oficiales de la campaña CyberWOW; o hasta agotar el stock de cupones disponibles; o hasta alcanzar el monto máximo destinado a descuentos de la campaña, lo que ocurra primero. El beneficio consiste en un 30% de descuento sobre el total de la compra, con una compra mínima de S/. 250 y un tope máximo de descuento de S/. 100 por usuario. El cupón CYBERWOW30 es válido para una sola compra por usuario y no es acumulable con otras promociones, descuentos, beneficios o cupones vigentes. La campaña aplica únicamente para compras virtuales y está sujeta a disponibilidad, validación del pedido y condiciones comerciales de la tienda." }
        };
    }

    private Cupon? cuponSeleccionado;

    public class Cupon {
    public string Codigo { get; set; }
    public string Titulo { get; set; }
    public string Subtitulo { get; set; }
    public string DescripcionLegal { get; set; }
    public DateTime FechaFin { get; set; }
        public decimal MontoMinimoCompra { get; set; }
        public decimal TopeMaximoDescuento { get; set; }
    }

    private bool mostrarModal = false;

    private void MostrarModal(Cupon cupon)
    {
        cuponSeleccionado = cupon;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }
}