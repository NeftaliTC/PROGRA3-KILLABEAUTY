@page "/"
@rendermode InteractiveServer
@using BlazorAppKillaBeauty.Services
@inject NavigationManager Navigation
@inject CartService CartService
@inject ProductoService ProductoService


<PageTitle>KILLA Beauty – Belleza que Inspira</PageTitle>

<Navbar CantidadCarrito="@CartService.CantidadTotal" />

<!-- BANNER PRINCIPAL -->
<section class="hero">
    <div class="hero-content">
        <h1>
            Descubre tu Belleza Natural
        </h1>

        <p>
            Los mejores productos de skincare,
            maquillaje y cuidado capilar
        </p>
        
        <div class="hero-buttons">
            <button class="btn-primary"
                    @onclick='() => Navigation.NavigateTo("/catalogo")'>
                Explorar Catálogo
            </button>

            <button class="btn-secondary"
                    @onclick='() => Navigation.NavigateTo("/register")'>
                Registrarse Ahora
            </button>
        </div>
    </div>
</section>

<!-- BENEFICIOS -->
<section class="benefits">

    <div class="benefit-card">
        <img src="Images/Original.png"
             alt="Originales" />

        <h3>Productos Originales</h3>

        <p>
            100% auténticos de las mejores marcas
        </p>
    </div>

    <div class="benefit-card">
        <img src="Images/Transporte.png"
             alt="Envío" />

        <h3>Envío Rápido</h3>

        <p>
            Delivery en 24–48 horas en Lima
        </p>
    </div>

    <div class="benefit-card">
        <img src="Images/Seguridad.png"
             alt="Seguridad" />

        <h3>Compra Segura</h3>

        <p>
            Pago protegido y garantizado
        </p>
    </div>

</section>

<!-- CATEGORÍAS -->
<!-- CATEGORÍAS -->
<section class="categories">

    <h2 class="section-title">Categorías Destacadas</h2>
    <p class="section-subtitle">Encuentra lo que necesitas</p>

    <div class="category-grid">

        <NavLink href="/catalogo/Skincare" class="category-card category-link">

            <img src="Images/CuidadoPiel.png"
                 alt="Skincare" />

            <h3>Skincare</h3>

            <p>
                Cuidado de la piel
            </p>

        </NavLink>

        <NavLink href="/catalogo/Makeup" class="category-card category-link">

            <img src="Images/Maquillaje.png"
                 alt="Maquillaje" />

            <h3>Maquillaje</h3>

            <p>
                Productos de maquillaje
            </p>

        </NavLink>

        <NavLink href="/catalogo/Cuidado-del-cabello" class="category-card category-link">

            <img src="Images/CuidadoCabello.png"
                 alt="Cabello" />

            <h3>Cuidado del Cabello</h3>

            <p>
                Productos para el cabello
            </p>

        </NavLink>

        <NavLink href="/catalogo/Fragancias" class="category-card category-link">

            <img src="Images/Fragancia.png"
                 alt="Fragancias" />

            <h3>Fragancias</h3>

            <p>
                Perfumes y colonias
            </p>

        </NavLink>

    </div>

</section>

<!-- PRODUCTOS -->
<section class="products">

    <h2 class="section-title">Productos Populares</h2>
    <p class="section-subtitle">Nuestros favoritos</p>

    <div class="product-grid">

        @for (int i = 0; i < productos.Count; i++)
        {
            var producto = productos[i];
            var index = i;

            <div class="product-card" @onclick="@(() => IrADetalleProducto(producto.Nombre))">

                <div class="product-image">

                    <img src="@producto.Imagen" alt="@producto.Nombre" />

                </div>

                <div class="product-info">

                    <h3>@producto.Nombre</h3>

                    <div class="stars">
                        <span>★</span>
                        <span>★</span>
                        <span>★</span>
                        <span>★</span>
                        <span class="star-empty">★</span>
                    </div>

                    <div class="product-footer">

                        <span class="price">
                            S/ @producto.Precio
                        </span>

                        <button type="button"
                                class="cart-btn @(productosAnimados.Contains(index) ? "cart-added" : "")"
                                @onclick:stopPropagation="true"
                                @onclick="() => AgregarCarrito(index)">
                            @if (productosAnimados.Contains(index))
                            {
                                <i class="bi bi-check-lg"></i>
                            }
                            else
                            {
                                <i class="bi bi-cart3"></i>
                            }

                        </button>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

<!-- DISTRIBUIDORES -->
<section class="distributor">

    <h2>
        ¿Eres distribuidor?
    </h2>

    <p>
        Ofrecemos precios especiales para compras al por mayor.
        <br />
        Cotiza desde media docena hasta cajones completos.
    </p>

    <button class="btn-distributor"
            @onclick="AbrirModalMayorista">
        Ver precios mayoristas
    </button>

</section>

@if (mostrarModalMayorista)
{
    <div class="wholesale-modal-overlay">
        <section class="wholesale-modal">
            @if (productoMayoristaSeleccionado == null)
            {
                <header class="wholesale-modal-header">
                    <div>
                        <h2>Elige un producto</h2>
                        <p>Selecciona el producto para ver sus precios</p>
                    </div>

                    <button type="button"
                            class="wholesale-icon-btn"
                            aria-label="Cerrar"
                            @onclick="CerrarModalMayorista">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </header>

                <div class="wholesale-search-wrap">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           placeholder="Buscar producto o marca..."
                           @bind="busquedaMayorista"
                           @bind:event="oninput" />
                </div>

                <div class="wholesale-list">
                    @if (!ProductosMayoristasFiltrados.Any())
                    {
                        <div class="wholesale-empty">
                            No encontramos productos con esa búsqueda.
                        </div>
                    }
                    else
                    {
                        @foreach (var producto in ProductosMayoristasFiltrados)
                        {
                            <button type="button"
                                    class="wholesale-product-row"
                                    @onclick="() => SeleccionarProductoMayorista(producto)">
                                <img src="@producto.Imagen" alt="@producto.Nombre" />

                                <span class="wholesale-product-name">
                                    @producto.Nombre
                                    <small>@producto.Marca</small>
                                </span>

                                <span class="wholesale-product-price">
                                    <small>Desde</small>
                                    S/ @producto.PrecioMinimo.ToString("0.00")
                                </span>
                            </button>
                        }
                    }
                </div>

                <footer class="wholesale-modal-footer">
                    <button type="button"
                            class="wholesale-btn ghost"
                            @onclick="CerrarModalMayorista">
                        Cerrar
                    </button>

                    <button type="button"
                            class="wholesale-btn primary"
                            @onclick='() => Navigation.NavigateTo("/catalogo")'>
                        Ir al catálogo
                    </button>
                </footer>
            }
            else
            {
                <header class="wholesale-modal-header detail">
                    <button type="button"
                            class="wholesale-icon-btn"
                            aria-label="Volver"
                            @onclick="VolverAListaMayorista">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div>
                        <h2>Precios mayoristas</h2>
                        <p>@productoMayoristaSeleccionado.Nombre</p>
                    </div>

                    <button type="button"
                            class="wholesale-icon-btn"
                            aria-label="Cerrar"
                            @onclick="CerrarModalMayorista">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </header>

                <div class="wholesale-detail-body">
                    <article class="wholesale-selected-product">
                        <img src="@productoMayoristaSeleccionado.Imagen" alt="@productoMayoristaSeleccionado.Nombre" />

                        <div>
                            <h3>@productoMayoristaSeleccionado.Nombre</h3>
                            <p>Stock: 150 unidades</p>
                        </div>
                    </article>

                    @foreach (var escala in EscalasMayoristas)
                    {
                        <article class="wholesale-scale @(escala.EsMejorPrecio ? "best" : "")">
                            <div>
                                <h3>
                                    @escala.Nombre

                                    @if (!string.IsNullOrEmpty(escala.Descuento))
                                    {
                                        <span>@escala.Descuento</span>
                                    }

                                    @if (escala.EsMejorPrecio)
                                    {
                                        <strong>Mejor precio</strong>
                                    }
                                </h3>

                                <p>@escala.Descripcion</p>
                            </div>

                            <div class="wholesale-scale-price">
                                <small>Precio c/u</small>
                                <b>S/ @escala.PrecioUnitario.ToString("0.00")</b>

                                @if (escala.Total > escala.PrecioUnitario)
                                {
                                    <small>Total: S/ @escala.Total.ToString("0.00")</small>
                                }
                            </div>
                        </article>
                    }

                    <div class="wholesale-note">
                        <i class="bi bi-box-seam"></i>
                        <span>
                            Los precios se aplican <strong>automáticamente en el carrito</strong> según la cantidad que elijas.
                        </span>
                    </div>
                </div>

                <footer class="wholesale-modal-footer">
                    <button type="button"
                            class="wholesale-btn ghost"
                            @onclick="CerrarModalMayorista">
                        Cerrar
                    </button>

                    <button type="button"
                            class="wholesale-btn primary"
                            @onclick="VerProductoMayorista">
                        Ver producto
                    </button>
                </footer>
            }
        </section>
    </div>
}

@code {
    private int cantidadCarrito = 0;


    private List<Producto> productos = new()
    {
        new Producto("Sérum Vitamina C Gold Kiwi", "65.00", "Images/Serum.jpg"),
        new Producto("Crema Hidratante Facial CeraVe", "69.90", "Images/Cerave.jpg"),
        new Producto("Labial Matte Ink Mood PERIPERA", "45.90", "Images/LabialPeripera.jpg"),
        new Producto("Máscara Essence Prince False Lash Effect", "52.90", "Images/Mascara.jpg"),
        new Producto("L03 Professional Protein Treatment LORINIQUE", "42.50", "Images/LoriniqueCabello.jpg")
    };

    private HashSet<int> productosAnimados = new();

    private async Task AgregarCarrito(int index)
    {
        CartService.AgregarProducto(
            productos[index].Nombre,
            decimal.Parse(productos[index].Precio),
            productos[index].Imagen
        );

        productosAnimados.Add(index);
        StateHasChanged();

        await Task.Delay(300);

        productosAnimados.Remove(index);
        StateHasChanged();
    }

    private class Producto
    {
        public string Nombre { get; set; }
        public string Precio { get; set; }
        public string Imagen { get; set; }

        public Producto(string descripcion, string precio, string imagen)
        {
            Nombre = descripcion;
            Precio = precio;
            Imagen = imagen;
        }
    }
    private void IrADetalleProducto(string nombreProducto)
    {
        Navigation.NavigateTo($"/usuario-producto/{ConvertirParaUrl(nombreProducto)}");
    }

    private bool mostrarModalMayorista = false;
    private string busquedaMayorista = "";
    private BlazorAppKillaBeauty.Services.Producto? productoMayoristaSeleccionado;

    private IEnumerable<BlazorAppKillaBeauty.Services.Producto> ProductosMayoristasFiltrados
    {
        get
        {
            var query = ProductoService.ObtenerTodos().AsEnumerable();

            if (!string.IsNullOrWhiteSpace(busquedaMayorista))
            {
                query = query.Where(producto =>
                    producto.Nombre.Contains(busquedaMayorista, StringComparison.OrdinalIgnoreCase)
                    || producto.Marca.Contains(busquedaMayorista, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private IEnumerable<EscalaMayorista> EscalasMayoristas
    {
        get
        {
            if (productoMayoristaSeleccionado == null)
            {
                return Enumerable.Empty<EscalaMayorista>();
            }

            var precioBase = productoMayoristaSeleccionado.PrecioMaximo > 0
                ? productoMayoristaSeleccionado.PrecioMaximo
                : productoMayoristaSeleccionado.PrecioMinimo;

            var mediaDocena = decimal.Round(precioBase * 0.89m, 2);
            var cajon = decimal.Round(precioBase * 0.78m, 2);

            return new List<EscalaMayorista>
            {
                new EscalaMayorista("Unidad", "1 unidad", precioBase, 1, "", false),
                new EscalaMayorista("Media docena", "6 unidades", mediaDocena, 6, "-11%", false),
                new EscalaMayorista("Cajón (24 unidades)", "24 unidades", cajon, 24, "-22%", true)
            };
        }
    }

    private void AbrirModalMayorista()
    {
        mostrarModalMayorista = true;
        productoMayoristaSeleccionado = null;
    }

    private void CerrarModalMayorista()
    {
        mostrarModalMayorista = false;
        productoMayoristaSeleccionado = null;
        busquedaMayorista = "";
    }

    private void SeleccionarProductoMayorista(BlazorAppKillaBeauty.Services.Producto producto)
    {
        productoMayoristaSeleccionado = producto;
    }

    private void VolverAListaMayorista()
    {
        productoMayoristaSeleccionado = null;
    }

    private void VerProductoMayorista()
    {
        if (productoMayoristaSeleccionado == null)
        {
            return;
        }

        Navigation.NavigateTo($"/usuario-producto/{ConvertirParaUrl(productoMayoristaSeleccionado.Nombre)}");
    }

    private string ConvertirParaUrl(string texto)
    {
        return texto
            .Trim()
            .Replace(" ", "-")
            .Replace("/", "-");
    }

    private record EscalaMayorista(
        string Nombre,
        string Descripcion,
        decimal PrecioUnitario,
        int Cantidad,
        string Descuento,
        bool EsMejorPrecio)
    {
        public decimal Total => PrecioUnitario * Cantidad;
    }
}
