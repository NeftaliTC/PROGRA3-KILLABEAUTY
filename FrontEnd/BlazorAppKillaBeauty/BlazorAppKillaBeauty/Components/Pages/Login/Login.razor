@page "/login"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión - Killa Beauty</PageTitle>

<section class="login-page">

    <div class="login-card">

        <NavLink href="/" class="back-home">
            <i class="bi bi-arrow-left"></i>
            Volver al inicio
        </NavLink>

        <div class="login-icon">
            <img src="Images/ImagenInicio.png" alt="Inicio sesión" />
        </div>

        <h1>Iniciar Sesión</h1>

        <p class="login-subtitle">
            Bienvenido a Killa Beauty
        </p>

        <div class="form-group">
            <label>Usuario</label>
            <input type="text"
                   placeholder="Ingresa tu usuario" @bind="usuario"/>
        </div>

        <div class="form-group">
            <label>Contraseña</label>
            <input type="password"
                   placeholder="Ingresa tu contraseña" @bind="password"/>
        </div>

        <div class="forgot-password">
            <a href="/forgot-password">¿Olvidaste tu contraseña?</a>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <p class="validation-message">@mensajeError</p>
        }

        <button type="button"
                class="login-button"
                @onclick="IniciarSesion">
            Iniciar Sesión
        </button>

        <p class="register-text">
            ¿No tienes cuenta?
            <a href="/register">Regístrate aquí</a>
        </p>

    </div>

</section>

@code {
    private string usuario = "";
    private string password = "";

    private string mensajeError = "";

    private void IniciarSesion()
    {
        mensajeError = "";

        // Validar vacíos
        if (string.IsNullOrWhiteSpace(usuario) ||
            string.IsNullOrWhiteSpace(password))
        {
            mensajeError =
                "Ingrese usuario y contraseña.";
            return;
        }

        // LOGIN CLIENTE
        if (usuario == "cliente" &&
            password == "cliente123")
        {
            AuthService.LoginCliente("Cliente");

            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        // LOGIN ADMIN
        if (usuario == "admin" &&
            password == "admin123")
        {
            AuthService.LoginAdmin("Administrador");

            Navigation.NavigateTo("/admin");
            return;
        }

        // ERROR
        mensajeError ="Usuario o contraseña incorrectos.";
    }
}

