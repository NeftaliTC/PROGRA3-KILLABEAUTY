                </button>
            </div>
            <ValidationMessage For="@(() => user.Contrasena)" class="validation-message text-danger" />
        </div>
 *@






        <div class="forgot-password">
            <a href="/forgot-password">¿Olvidaste tu contraseña?</a>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <p class="validation-message">@mensajeError</p>
        }

        <button type="button"
                class="login-button"
                @onclick="IniciarSesion"
                disabled="@loading">
            @(loading ? "Ingresando..." : "Iniciar Sesión")
        </button>

        <p class="register-text">
            ¿No tienes cuenta?
            <a href="/register">Regístrate aquí</a>
        </p>

    </div>

</section>
@code {
    // Usamos el mismo modelo, pero Blazor solo validará los campos que toquemos (Correo y Contraseña)
    private Usuario credenciales = new Usuario();
    private bool loading = false;
    private string mensajeError;
    private bool mostrarContrasena = false;

    // para activar el ojito de la contraseña 
    private void TogglePassword()
    {
        mostrarContrasena = !mostrarContrasena;
    }

    private async Task IniciarSesion()
    {
        loading = true;
        mensajeError = null;

        try
        {
            var usuarioLogueado = await UsuarioService.LoginAsync(credenciales);

            if (usuarioLogueado != null)
            {
               
                AuthService.Login(
                    usuarioLogueado.Nombre,
                    usuarioLogueado.Id,
                    usuarioLogueado.TipoUsuario,
                    usuarioLogueado.CorreoElectronico);
                string rolReal = usuarioLogueado.TipoUsuario?.Trim().ToUpper() ?? "";
                if (rolReal == "VENDEDOR" || rolReal == "ADMINISTRADOR")
                {
                    // Si es personal de la tienda, lo mandamos a tu panel
                    NavigationManager.NavigateTo("/admin");
                }
                else
                {
                    // Si es cliente normal, lo mandamos a la tienda
                    NavigationManager.NavigateTo("/");
                }
               
                // NavigationManager.NavigateTo("/"); // Redirigir al Home
            }
        }
        catch (Exception ex)
        {
            // Captura errores como "Credenciales incorrectas" o "Usuario no encontrado"
            mensajeError = ex.Message.Contains("400") || ex.Message.Contains("401") || ex.Message.Contains("404")
                ? "Correo o contraseña incorrectos."
                : ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
