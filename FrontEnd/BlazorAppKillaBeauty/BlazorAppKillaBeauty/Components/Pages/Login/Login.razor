@page "/login"
@rendermode InteractiveServer
@using ClienteREST.Models;
@using ClienteREST.ServicesAct

@inject UsuarioService UsuarioService
@inject AuthService AuthService
@inject NavigationManager NavigationManager



<PageTitle>Iniciar Sesión - Killa Beauty</PageTitle>

<section class="login-page">

    <div class="login-card">

        <NavLink href="/" class="back-home">
            <i class="bi bi-arrow-left"></i>
            Volver al inicio
        </NavLink>

        <div class="login-icon">
            <img src="Images/ImagenInicio.png" alt="Inicio sesión" />
        </div>

        <h1>Iniciar Sesión</h1>

        <p class="login-subtitle">
            Bienvenido a Killa Beauty
        </p>

        <div class="form-group">
            <label>Correo Electrónico</label>
            <input type="email"
                   placeholder="Ingresa tu correo" @bind="credenciales.CorreoElectronico" />
        </div>

        @*  cambiada  *@
        <div class="form-group">
            <label>Contraseña</label>
            <div style="position: relative; display: flex; align-items: center; width: 100%;">
            <input type="@(mostrarContrasena ? "text" : "password")"
                   placeholder="Ingresa tu contraseña" 
                   @bind="credenciales.Contrasena"
                style="width: 100%; padding-right: 40px;" />
            <button type="button"
                    @onclick="TogglePassword"
                    style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; font-size: 1.2rem;">
                <i class="@(mostrarContrasena ? "bi bi-eye" : "bi bi-eye-slash")"></i>
            </button>
            </div>
        </div>
        
 @*        <div class="form-group">
            <label>Contraseña</label>
            <div style="position: relative; display: flex; align-items: center;">
                <InputText @bind-Value="user.Contrasena" type="@(mostrarContrasena ? "text" : "password")" 
                    placeholder="Crea una contraseña" style="width: 100%; padding-right: 40px;" />
                <button type="button"
                        @onclick="TogglePassword"
                        style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; font-size: 1.2rem;">
