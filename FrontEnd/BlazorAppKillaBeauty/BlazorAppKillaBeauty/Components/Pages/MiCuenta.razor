@page "/micuenta"
@layout MainLayout
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation

<Navbar CantidadCarrito="0" />

<div class="page-background-wrapper">
    <div class="account-main-container">
        
        <h1 class="main-page-title">Mi Cuenta</h1>
        
        <div class="account-layout-grid">
            
            <div class="account-sidebar-card">
                <div class="profile-avatar-zone">
                    <div class="avatar-circle">C</div>
                    <h2 class="avatar-name">@profile.Nombres</h2>
                    <span class="avatar-email">@profile.Correo</span>
                </div>
                
                <div class="sidebar-menu-links">
                    <button class="menu-link-item active">
                        <i class="bi bi-person-fill"></i> Mi Perfil
                    </button>
                    <button class="menu-link-item">
                        <i class="bi bi-geo-alt"></i> Direcciones
                    </button>
                    <button class="menu-link-item">
                        <i class="bi bi-ticket-perforated"></i> Cupones
                    </button>
                    <button class="menu-link-item">
                        <i class="bi bi-lock"></i> Cambio de contraseña
                    </button>
                    <hr class="sidebar-divider" />
                    <button class="menu-link-item logout-btn" @onclick="CerrarSesion">
                        <i class="bi bi-box-arrow-left"></i> Cerrar Sesión
                    </button>
                </div>
            </div>

            <div class="account-content-card">
                <h2 class="card-inside-title">Mi Perfil</h2>
                
                <div class="profile-form-grid">
                    <div class="form-input-group">
                        <label>Nombres</label>
                        <input type="text" value="@profile.Nombres" @oninput="OnNombresInput" />
                    </div>
                    
                    <div class="form-input-group">
                        <label>Apellido Paterno</label>
                        <input type="text" value="@profile.ApellidoPaterno" @oninput="OnPaternoInput" />
                    </div>
                    
                    <div class="form-input-group">
                        <label>Apellido Materno</label>
                        <input type="text" value="@profile.ApellidoMaterno" @oninput="OnMaternoInput" />
                    </div>
                    
                    <div class="form-input-group">
                        <label>Correo electrónico</label>
                        <input type="email" value="@profile.Correo" disabled />
                    </div>
                    
                    <div class="form-input-group">
                        <label>Tipo de documento</label>
                        <select class="custom-select-field" value="@profile.TipoDocumento" disabled>
                            <option value="DNI">DNI</option>
                            <option value="RUC">RUC</option>
                            <option value="Pasaporte">Pasaporte</option>
                            <option value="Carné de Extranjería">Carné de Extranjería</option>
                        </select>
                    </div>
                    
                    <div class="form-input-group">
                        <label>Número de documento</label>
                        <input type="text" value="@profile.NumeroDocumento" disabled />
                    </div>
                    
                    <div class="form-input-group @(hasFechaError ? "has-error" : "")">
                        <label>Fecha de nacimiento</label>
                        <div class="killa-date-picker-combo">
                            <select class="custom-select-field" value="@selDay" @onchange="OnDayChanged">
                                @for (int d = 1; d <= 31; d++)
                                {
                                    <option value="@d">@d.ToString("D2")</option>
                                }
                            </select>
                            
                            <select class="custom-select-field" value="@selMonth" @onchange="OnMonthChanged">
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                            
                            <select class="custom-select-field" value="@selYear" @onchange="OnYearChanged">
                                @for (int y = 2008; y >= 1920; y--)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>
                        @if (hasFechaError)
                        {
                            <span class="error-hint-text">⚠️ Selecciona una combinación de fecha válida</span>
                        }
                    </div>
                    
                    <div class="form-input-group">
                        <label>Género</label>
                        <select class="custom-select-field" value="@profile.Genero" @onchange="OnGeneroChange">
                            <option value="Selecciona">Selecciona</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    
                    <div class="form-input-group @(hasCelularError ? "has-error" : "")">
                        <label>Número de celular</label>
                        <input type="text"
                               value="@profile.Celular"
                               @oninput="OnCelularInput"
                               maxlength="9"
                               inputmode="numeric" />
                        @if (hasCelularError)
                        {
                            <span class="error-hint-text">⚠️ Introduce un celular válido (9 dígitos)</span>
                        }
                    </div>
                    
                    <div class="form-input-group empty-space-block"></div>
                </div>

                <div class="form-actions-area">
                    <button class="killa-save-button @(canSave ? "state-active" : "state-disabled")"
                            disabled="@(!canSave)"
                            @onclick="ProcessFormSave">
                        Guardar cambios
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private class UserProfileData
    {
        public string Nombres { get; set; } = "";
        public string ApellidoPaterno { get; set; } = "";
        public string ApellidoMaterno { get; set; } = "";
        public string Correo { get; set; } = "";
        public string TipoDocumento { get; set; } = "DNI";
        public string NumeroDocumento { get; set; } = "";
        public DateTime? FechaNacimiento { get; set; }
        public string Genero { get; set; } = "Selecciona";
        public string Celular { get; set; } = "";
    }

    private UserProfileData profile = new();
    private UserProfileData originalSnapshot = new();

    private int selDay = 15;
    private int selMonth = 4;
    private int selYear = 2004;

    private bool hasFechaError = false;
    private bool hasCelularError = false;
    private bool canSave = false;

    protected override void OnInitialized()
    {
        profile = new UserProfileData
        {
            Nombres = "Moises",
            ApellidoPaterno = "Alvarado",
            ApellidoMaterno = "Moscoso",
            Correo = "moises.alvarado@example.com",
            TipoDocumento = "DNI",
            NumeroDocumento = "72817267",
            FechaNacimiento = new DateTime(2004, 04, 15),
            Genero = "Masculino",
            Celular = "964245541"
        };

        selDay = profile.FechaNacimiento.Value.Day;
        selMonth = profile.FechaNacimiento.Value.Month;
        selYear = profile.FechaNacimiento.Value.Year;

        TakeDataSnapshot();
        ValidateForm();
    }

    private void TakeDataSnapshot()
    {
        originalSnapshot = new UserProfileData
        {
            Nombres = profile.Nombres,
            ApellidoPaterno = profile.ApellidoPaterno,
            ApellidoMaterno = profile.ApellidoMaterno,
            Correo = profile.Correo,
            TipoDocumento = profile.TipoDocumento,
            NumeroDocumento = profile.NumeroDocumento,
            FechaNacimiento = profile.FechaNacimiento,
            Genero = profile.Genero,
            Celular = profile.Celular
        };
    }

    private void ValidateForm()
    {
        hasCelularError = string.IsNullOrEmpty(profile.Celular) ||
                          profile.Celular.Length < 9 ||
                          !profile.Celular.StartsWith("9");

        bool isDirty = profile.Nombres != originalSnapshot.Nombres ||
                       profile.ApellidoPaterno != originalSnapshot.ApellidoPaterno ||
                       profile.ApellidoMaterno != originalSnapshot.ApellidoMaterno ||
                       profile.FechaNacimiento != originalSnapshot.FechaNacimiento ||
                       profile.Genero != originalSnapshot.Genero ||
                       profile.Celular != originalSnapshot.Celular;

        canSave = isDirty && !hasFechaError && !hasCelularError;
        
        StateHasChanged();
    }

    private void OnNombresInput(ChangeEventArgs e) { profile.Nombres = e.Value?.ToString() ?? ""; ValidateForm(); }
    private void OnPaternoInput(ChangeEventArgs e) { profile.ApellidoPaterno = e.Value?.ToString() ?? ""; ValidateForm(); }
    private void OnMaternoInput(ChangeEventArgs e) { profile.ApellidoMaterno = e.Value?.ToString() ?? ""; ValidateForm(); }
    private void OnGeneroChange(ChangeEventArgs e) { profile.Genero = e.Value?.ToString() ?? "Selecciona"; ValidateForm(); }

    private void OnCelularInput(ChangeEventArgs e)
    {
        string rawValue = e.Value?.ToString() ?? "";
        profile.Celular = new string(rawValue.Where(char.IsDigit).ToArray());
        ValidateForm();
    }

    private void OnDayChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int val)) { selDay = val; RebuildDate(); } }
    private void OnMonthChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int val)) { selMonth = val; RebuildDate(); } }
    private void OnYearChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int val)) { selYear = val; RebuildDate(); } }

    private void RebuildDate()
    {
        try
        {
            profile.FechaNacimiento = new DateTime(selYear, selMonth, selDay);
            hasFechaError = false;
        }
        catch (ArgumentOutOfRangeException)
        {
            profile.FechaNacimiento = null;
            hasFechaError = true;
        }
        ValidateForm();
    }

    private void ProcessFormSave()
    {
        if (canSave)
        {
            TakeDataSnapshot();
            ValidateForm();
        }
    }

    private void CerrarSesion()
    {
        // Le avisamos al servicio que limpie el estado de la sesión
        AuthService.Logout();
        // Redirige directamente a la página principal tras pulsar cerrar sesión
        Navigation.NavigateTo("/");
    }
}