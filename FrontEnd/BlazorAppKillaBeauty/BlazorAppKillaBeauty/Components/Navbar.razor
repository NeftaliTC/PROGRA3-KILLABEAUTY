@inject AuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@using BlazorAppKillaBeauty.ClienteREST.Models
@inject ProductoService ProductoService
@using BlazorAppKillaBeauty.Services

<link rel="stylesheet" href="@Assets["app.css"]" />

<nav class="navbar-killa">
    <a href="/">
        <img src="Images/Logo.png"
             class="logo"
             alt="Logo" />
    </a>
    
    <SearchBox TodosLosProductos="@TodosLosProductos" />

    <div class="nav-links">

        <NavLink href="/catalogo">
            Catálogo
        </NavLink>

        <NavLink href="/cart" class="cart-navbar-btn">

            <i class="bi bi-cart3"></i>

            @if (CantidadCarrito > 0)
            {
                <span class="cart-badge">
                    @CantidadCarrito
                </span>
            }

        </NavLink>

        @if (AuthService.EstaLogueado)
        {
            <a href="/orders" class="nav-user-link">
                <i class="bi bi-box-seam"></i>
                Pedidos
            </a>

            <NavLink href="/account/profile" class="user-profile-menu-link">
                <div class="user-profile">

                    <div class="user-avatar">
                        @AuthService.NombreUsuario.Substring(0, 1).ToUpper()
                    </div>

                    <span class="user-name">
                        @AuthService.NombreUsuario
                    </span>

                </div>
            </NavLink>
        }
        else
        {
            <NavLink href="/login">
                Iniciar Sesión
            </NavLink>

            <NavLink href="/register" class="btn-register">
                Registrarse
            </NavLink>
        }
    </div>
</nav>

@code {
    [Parameter] public int CantidadCarrito { get; set; }
    [Parameter] public List<Producto> TodosLosProductos { get; set; } = new();
}