@inject AuthService AuthService
<link rel="stylesheet" href="@Assets["app.css"]" />

<nav class="navbar-killa">
    <img src="Images/Logo.png"
         class="logo"
         alt="Logo" />

    <div class="search-container">

        <i class="bi bi-search search-icon"></i>

        <input type="text"
               class="search-box"
               placeholder="Buscar productos, marcas..." />

    </div>

    <div class="nav-links">

        <NavLink href="/catalogo">
            Catálogo
        </NavLink>

        <button class="cart-navbar-btn">

            <i class="bi bi-cart3"></i>

            @if (CantidadCarrito > 0)
            {
                <span class="cart-badge">
                    @CantidadCarrito
                </span>
            }

        </button>

        @if (AuthService.EstaLogueado)
        {
            <a href="/pedidos" class="nav-user-link">
                <i class="bi bi-box-seam"></i>
                Pedidos
            </a>

            <div class="user-profile">

                <div class="user-avatar">
                    @AuthService.NombreUsuario.Substring(0, 1).ToUpper()
                </div>

                <span class="user-name">
                    @AuthService.NombreUsuario
                </span>

            </div>
        }
        else
        {
            <NavLink href="/login">
                Iniciar Sesión
            </NavLink>

            <NavLink href="/register" class="btn-register">
                Registrarse
            </NavLink>
        }
    </div>
</nav>

@code {
    [Parameter]
    public int CantidadCarrito { get; set; }
}